# Kopiere diese Datei nach .env und trage die echten Werte ein.
# Project-ID findest du unter https://www.sanity.io/manage (oder nach `npx sanity init`).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Zugang zum eingebetteten Sanity-Studio (/admin) im öffentlichen Deploy.
# Frei wählbar. Greift NUR auf Vercel (Edge Middleware), nicht im lokalen `astro dev`.
# Ohne diese Werte bleibt /admin auf Vercel komplett gesperrt.
ADMIN_USER=
ADMIN_PASSWORD=
