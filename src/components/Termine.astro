---
/**
 * "Nächste Termine"-Block (claude.md Abschnitt 6.5)
 * Kompakte Liste: Datum, Gegner/Anlass, Ort, Uhrzeit.
 * ⚠️ Platzhalter-Termine – später durch echte Daten ersetzen.
 */
const termine = [
  {
    tag: "Sa",
    datum: "28.06.",
    sparte: "Fußball",
    titel: "FC Lübbecke I – TuS Hille",
    ort: "Sportplatz Am Gehlenbach",
    zeit: "15:00 Uhr",
  },
  {
    tag: "Mi",
    datum: "02.07.",
    sparte: "Badminton",
    titel: "Offenes Training & Schnupperabend",
    ort: "Sporthalle Kollegienwall",
    zeit: "19:30 Uhr",
  },
  {
    tag: "Fr",
    datum: "04.07.",
    sparte: "Darts",
    titel: "Liga-Heimspiel gegen die Eagles",
    ort: "Vereinsheim, Clubraum",
    zeit: "20:00 Uhr",
  },
  {
    tag: "So",
    datum: "06.07.",
    sparte: "Verein",
    titel: "Sommerfest des FC Lübbecke",
    ort: "Vereinsgelände",
    zeit: "ab 11:00 Uhr",
  },
];
---

<section class="termine" aria-labelledby="termine-title">
  <div class="container">
    <header class="termine__head">
      <h2 id="termine-title" class="section-title">Nächste Termine</h2>
      <p class="termine__intro">
        Spiele, Training und Vereinsleben – was in den nächsten Wochen ansteht.
      </p>
    </header>

    <ul class="termine__list">
      {termine.map((t) => (
        <li class="termin">
          <div class="termin__date" aria-hidden="true">
            <span class="termin__day">{t.tag}</span>
            <span class="termin__num">{t.datum}</span>
          </div>
          <div class="termin__main">
            <span class="tag">{t.sparte}</span>
            <p class="termin__title">{t.titel}</p>
            <p class="termin__meta">
              <span class="sr-only">Datum: </span>{t.tag}, {t.datum} · {t.ort} · {t.zeit}
            </p>
          </div>
          <div class="termin__time" aria-hidden="true">{t.zeit}</div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .termine {
    background: var(--color-green-050);
    padding-block: var(--space-6);
  }

  .termine__head {
    margin-bottom: var(--space-4);
  }
  .termine__intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .termine__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .termin {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-2) var(--space-3);
  }

  /* Datums-Block links */
  .termin__date {
    display: grid;
    justify-items: center;
    align-content: center;
    flex: none;
    width: 64px;
    padding: 0.4rem 0;
    border-radius: var(--radius-sm);
    background: var(--color-green-700);
    color: #fff;
    font-family: var(--font-head);
    line-height: 1.1;
  }
  .termin__day {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.9;
  }
  .termin__num {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .termin__main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .termin__title {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-h3);
    color: var(--color-green-900);
  }
  .termin__meta {
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .termin__time {
    display: none;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--color-green-700);
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* Desktop: Uhrzeit als eigene Spalte rechts, Meta-Zeile gekürzt */
  @media (min-width: 760px) {
    .termin {
      grid-template-columns: auto 1fr auto;
    }
    .termin__time {
      display: block;
    }
  }
</style>
