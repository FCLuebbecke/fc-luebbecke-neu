---
/**
 * Sparten-Unterseite "Mannschaften" (Landung): Kurzvorstellung + Teams + Fotos.
 */
import type { SparteData } from "../data/sparten";
interface Props { data: SparteData; }
const { data } = Astro.props as Props;
---

<main id="inhalt">
  <section class="container section">
    <h2 class="section-title">Mannschaften &amp; Gruppen</h2>
    <div class="teams">
      {data.teams.map((t) => (
        <article class="team">
          <div class="team__head">
            <h3 class="team__name">{t.name}</h3>
            {t.liga && <span class="tag">{t.liga}</span>}
          </div>
          <p class="team__info">{t.info}</p>
          {t.href && (
            <a class="team__link" href={t.href} target="_blank" rel="noopener noreferrer">
              Spielplan &amp; Tabelle <span aria-hidden="true">↗</span>
              <span class="sr-only"> (öffnet in neuem Fenster)</span>
            </a>
          )}
          {t.platzhalter && <p class="platzhalter">Daten folgen</p>}
        </article>
      ))}
    </div>
  </section>
</main>

<style>
  .section { padding-block: var(--space-6); }

  .teams {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .team {
    position: relative;
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
    padding-top: calc(var(--space-4) + 4px);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .team::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--color-green-500);
  }
  .team:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: rgba(10, 80, 18, 0.18);
  }
  .team__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .team__name { color: var(--color-green-900); }
  .team__info { margin-top: 0.6rem; }
  .team__link {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-green-700);
    text-decoration: none;
  }
  .team__link:hover { text-decoration: underline; text-underline-offset: 2px; }
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .platzhalter {
    margin-top: 0.75rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    font-style: italic;
  }

  @media (min-width: 760px) {
    .teams { grid-template-columns: repeat(2, 1fr); }
  }
</style>
