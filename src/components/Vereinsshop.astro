---
/**
 * Vereinsshop-Banner (Spec 011) – „Trag Lübbecke.“
 * Aktionsbanner für den Macron-Vereinsshop, direkt unter dem Hero.
 * Rabatt-Badge, Rabatt-Satz und Streichpreise hängen am Enddatum
 * RABATT_BIS: nach diesem Tag (Build-Datum) bleibt der Banner ohne Aktion.
 * Bilder/Preise sind statisch (Macron hat keine Schnittstelle) – Bilder in
 * public/shop-*.webp sind 1:1 austauschbar.
 */
export const SHOP_URL = "https://clubshop.macron.com/selfd_gmbh/fc-lubbecke-e-v";

const RABATT_VON = "26.11.";
const RABATT_BIS_LABEL = "10.12.";
const RABATT_BIS = new Date("2026-12-10T23:59:59+01:00");
const aktion = new Date() <= RABATT_BIS;

const produkte = [
  {
    name: "Cerberus Eco",
    art: "Trikot",
    bild: "/shop-trikot.webp",
    alt: "Grünes Heimtrikot Cerberus Eco des FC Lübbecke",
    preis: 60.0,
  },
  {
    name: "Odin",
    art: "Sweatshirt mit Reißverschluss",
    bild: "/shop-jacke.webp",
    alt: "Dunkelgrüne Sweatjacke Odin des FC Lübbecke",
    preis: 51.9,
  },
];

const euro = (n: number) =>
  n.toLocaleString("de-DE", { style: "currency", currency: "EUR" });
const rabattiert = (n: number) => Math.round(n * 0.9 * 100) / 100;
---

<section class="shop" aria-labelledby="shop-title">
  <div class="container shop__inner">
    <div class="shop__text">
      <p class="shop__brand">
        <img src="/logo.png" alt="" width="1024" height="205" loading="lazy" />
      </p>

      <h2 id="shop-title" class="shop__title">Trag Lübbecke.</h2>

      <p class="shop__lead">
        Der Vereinsshop ist offen.
        {aktion && (
          <> 10 % Eröffnungsrabatt vom {RABATT_VON} bis {RABATT_BIS_LABEL}</>
        )}
      </p>

      <a class="shop__cta" href={SHOP_URL} target="_blank" rel="noopener noreferrer">
        Zum Vereinsshop <span aria-hidden="true">→</span>
        <span class="sr-only"> (öffnet in neuem Fenster)</span>
      </a>
    </div>

    {aktion && (
      <p class="shop__badge" aria-label={`Minus 10 Prozent bis ${RABATT_BIS_LABEL}`}>
        <span class="shop__badge-big" aria-hidden="true">−10 %</span>
        <span class="shop__badge-small" aria-hidden="true">bis {RABATT_BIS_LABEL}</span>
      </p>
    )}

    <ul class="shop__products" aria-label="Beispiele aus dem Vereinsshop">
      {produkte.map((p, i) => (
        <li class:list={["product", { "product--offset": i === 1 }]}>
          <a class="product__link" href={SHOP_URL} target="_blank" rel="noopener noreferrer">
            <img class="product__img" src={p.bild} alt={p.alt} width="400" height="520" loading="lazy" />
            <span class="product__meta">
              <span class="product__name">{p.name}</span>
              <span class="product__art">{p.art}</span>
            </span>
            <span class="product__price">
              {aktion && <s class="product__old">{euro(p.preis)}</s>}
              <span class="product__now">{euro(aktion ? rabattiert(p.preis) : p.preis)}</span>
            </span>
            <span class="sr-only"> (öffnet in neuem Fenster)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .shop {
    --shop-ink: #0b4a1e;
    --shop-lime: #c8f25a;
    background: var(--color-green-900);
    color: var(--color-white);
    overflow: hidden;
  }

  .shop__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  /* Logo-Lockup */
  .shop__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .shop__brand img {
    height: 40px;
    width: auto;
    /* Logo ist grün – auf dunklem Grund weiß unterlegen (wie im Footer) */
    background: #fff;
    padding: 5px 9px;
    border-radius: var(--radius-sm);
  }

  .shop__title {
    margin-top: var(--space-3);
    font-size: clamp(2.6rem, 1.2rem + 7.5vw, 6.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .shop__lead {
    margin-top: var(--space-3);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.375rem);
    max-width: 44ch;
  }

  .shop__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-3);
    min-height: var(--tap);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1.1rem, 1rem + 0.8vw, 1.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-white);
    border-bottom: 5px solid var(--shop-lime);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .shop__cta:hover,
  .shop__cta:focus-visible {
    color: var(--shop-lime);
    border-color: var(--color-white);
  }

  /* Rabatt-Badge: leicht gedrehter Kreis */
  .shop__badge {
    position: absolute;
    right: var(--space-3);
    top: var(--space-4);
    display: grid;
    place-content: center;
    text-align: center;
    width: clamp(96px, 20vw, 150px);
    aspect-ratio: 1;
    margin: 0;
    border-radius: 999px;
    background: var(--shop-lime);
    color: var(--shop-ink);
    transform: rotate(-8deg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    font-family: var(--font-head);
    line-height: 1;
  }
  .shop__badge-big {
    font-size: clamp(1.6rem, 1rem + 2.6vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .shop__badge-small {
    margin-top: 0.3em;
    font-size: clamp(0.8rem, 0.7rem + 0.6vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Produktkarten */
  .shop__products {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    align-items: start;
  }
  .product {
    background: #fff;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }
  .product__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-2);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .product__link:hover,
  .product__link:focus-visible {
    transform: translateY(-3px);
  }
  .product__img {
    width: 100%;
    height: auto;
    aspect-ratio: 400 / 520;
    object-fit: contain;
  }
  .product__meta {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }
  .product__name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .product__art {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: var(--space-1);
  }
  .product__old {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .product__now {
    display: inline-block;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    background: var(--shop-ink);
    color: var(--shop-lime);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 599px) {
    /* Handy: Badge nicht über die Überschrift legen, sondern neben den CTA */
    .shop__badge {
      position: static;
      transform: rotate(-6deg);
      margin-top: calc(-1 * var(--space-2));
      justify-self: end;
    }
  }

  @media (min-width: 900px) {
    .shop__inner {
      grid-template-columns: 1.4fr auto 1fr;
      align-items: center;
      gap: var(--space-5);
      padding-block: var(--space-6);
    }
    .shop__badge {
      position: static;
      transform: rotate(-8deg);
      align-self: end;
      margin-bottom: var(--space-2);
    }
    .shop__products {
      gap: var(--space-3);
    }
    /* zweite Karte versetzt wie in der Vorlage */
    .product--offset {
      margin-top: var(--space-5);
    }
  }
</style>
