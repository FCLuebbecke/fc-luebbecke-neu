---
/**
 * Sparten-Unterseite "Trainingszeiten": Zeiten + Ort/Halle.
 */
import type { SparteData } from "../data/sparten";
interface Props { data: SparteData; }
const { data } = Astro.props as Props;
---

<main id="inhalt">
  <section class="sparte__training">
    <div class="container sparte__training-grid">
      <div>
        <h2 class="section-title">Trainingszeiten</h2>
        <ul class="zeiten">
          {data.training.map((t) => (
            <li class="zeit">
              <span class="zeit__gruppe">{t.gruppe}</span>
              <span class="zeit__zeit">
                <svg class="zeit__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                  <path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                {t.zeit}
              </span>
            </li>
          ))}
        </ul>
        <p class="hinweis">Angaben ohne Gewähr – in den Ferien kann es Abweichungen geben.</p>
      </div>

      <aside class="ort">
        <svg class="ort__pin" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <circle cx="12" cy="9" r="2.5" fill="currentColor" />
        </svg>
        <h3 class="ort__title">Wo wir trainieren</h3>
        <p class="ort__name">{data.ortName}</p>
        <address class="ort__adresse">{data.ortAdresse}</address>
      </aside>
    </div>
  </section>
</main>

<style>
  .sparte__training { padding-block: var(--space-6); }
  .sparte__training-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .zeiten {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .zeit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    background: var(--color-green-050);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-sm);
    padding: 0.85rem var(--space-3);
  }
  .zeit__gruppe {
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-green-900);
  }
  .zeit__zeit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .zeit__icon {
    width: 1.05em;
    height: 1.05em;
    color: var(--color-green-700);
    flex: none;
  }
  .hinweis {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .ort {
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
  }
  .ort__pin {
    width: 2rem;
    height: 2rem;
    color: var(--color-green-700);
    margin-bottom: var(--space-2);
  }
  .ort__title { margin-bottom: 0.5rem; }
  .ort__name {
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-green-900);
  }
  .ort__adresse {
    font-style: normal;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  @media (min-width: 860px) {
    .sparte__training-grid {
      grid-template-columns: 1.4fr 0.6fr;
      gap: var(--space-6);
    }
  }
</style>
