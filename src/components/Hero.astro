---
/**
 * Hero – Startseite (claude.md Abschnitt 6.2)
 * Stil: "Immersives Vollbild-Foto" – das echte Vereinsfoto füllt die volle
 * Breite, ein sattes Grün-Schleier sorgt für Kontrast. Inhalt mittig zentriert:
 * Kicker, große weiße Oswald-Überschrift, Claim und zwei CTAs. Bewusst der
 * einzige dunkle, wuchtige Block – sticht gegen den hellen Rest der Seite heraus.
 *
 * Das Foto ist 1:1 austauschbar (Prop `image`); Platzhalter funktioniert.
 */
interface Props {
  /** Pfad zum Hero-Foto. Platzhalter ist 1:1 austauschbar. */
  image?: string;
  imageAlt?: string;
}

import SparteIcon from "./SparteIcon.astro";

const {
  image = "/hero.jpg",
  imageAlt = "Luftaufnahme des Vereinsgeländes des FC Lübbecke im Abendlicht",
} = Astro.props;

/* Die vier Sportangebote als Signatur im Hero – „ein Verein, vier Sparten".
   Icons wie im Sparten-Block (Inline-SVG, siehe SparteIcon.astro). */
const sparten = [
  { label: "Fußball", icon: "fussball" },
  { label: "Badminton", icon: "badminton" },
  { label: "Darts", icon: "darts" },
  { label: "Laufsport", icon: "laufsport" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Foto füllt die volle Fläche. Standardbild: responsive WebP-Varianten,
       damit Handys nicht das 1920er-Bild laden; eigenes Bild via Prop = 1:1. -->
  {image === "/hero.jpg" ? (
    <picture>
      <source
        type="image/webp"
        srcset="/hero-768.webp 768w, /hero-1280.webp 1280w, /hero-1920.webp 1920w"
        sizes="100vw"
      />
      <img
        class="hero__bg"
        src="/hero-1920.jpg"
        alt={imageAlt}
        width="1920"
        height="1152"
        fetchpriority="high"
      />
    </picture>
  ) : (
    <img
      class="hero__bg"
      src={image}
      alt={imageAlt}
      width="2000"
      height="1200"
      fetchpriority="high"
    />
  )}
  <span class="hero__veil" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__kicker">
        <span class="hero__kicker-bar" aria-hidden="true"></span>
        Sportverein seit 1925 · Lübbecke
      </p>

      <h1 id="hero-title" class="hero__title">FC Lübbecke</h1>

      <p class="hero__claim">Unser Verein. Unser Lübbecke.</p>

      <p class="hero__lead">
        Fußball, Badminton, Darts und Laufsport – vier Sparten, ein Verein.
        Bei uns ist jeder willkommen, der Sport und Gemeinschaft liebt.
      </p>

      <div class="hero__actions">
        <a class="btn btn--light" href="/mitglied-werden">Mitglied werden</a>
        <a class="btn btn--ghost-light" href="#sparten">Unsere Sparten</a>
      </div>

      <!-- Signatur: ein Verein, vier Sparten -->
      <ul class="hero__sparten" aria-label="Unsere vier Sportangebote">
        {sparten.map((s) => (
          <li class="hero__sparte">
            <span class="hero__sparte-icon" aria-hidden="true"><SparteIcon name={s.icon} /></span>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- dezentes "gegründet 1925"-Siegel -->
  <span class="hero__seal" aria-hidden="true">
    <span class="hero__seal-year">1925</span>
    <span class="hero__seal-label">gegründet</span>
  </span>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: clamp(30rem, 78vh, 46rem);
    overflow: hidden;
    background: var(--color-green-900);
  }

  /* Foto: füllt die Fläche, langsamer Ken-Burns-Zoom für Lebendigkeit */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 60% 45%;
    animation: hero-kenburns 28s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* Grün-Schleier: gleichmäßig dunkel für Textkontrast in der Mitte,
     dazu eine sanfte Vignette (außen dunkler) – Fokus zentriert. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        120% 95% at 50% 50%,
        rgba(8, 45, 13, 0.55) 0%,
        rgba(7, 38, 11, 0.78) 70%,
        rgba(6, 30, 10, 0.9) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 45, 13, 0.45) 0%,
        rgba(8, 45, 13, 0.55) 100%
      );
  }

  .hero__inner {
    position: relative;
    width: 100%;
    padding-block: var(--space-6);
  }

  .hero__content {
    width: 100%;
    color: var(--color-white);
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: var(--space-3);
  }
  .hero__kicker-bar {
    width: 38px;
    height: 4px;
    background: var(--color-green-500);
    border-radius: 2px;
    flex: none;
  }

  .hero__title {
    font-size: clamp(3rem, 1.6rem + 7vw, 6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--color-white);
    text-shadow: 0 2px 24px rgba(6, 30, 10, 0.45);
  }

  .hero__claim {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-white);
    margin-top: var(--space-2);
    text-shadow: 0 1px 16px rgba(6, 30, 10, 0.4);
  }

  .hero__lead {
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.88);
    max-width: 46ch;
    margin-inline: auto;
  }

  .hero__actions {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  /* ---- Sparten-Signatur (ein Verein, vier Sparten) ---- */
  .hero__sparten {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
  }
  .hero__sparte {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__sparte-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
  }

  /* rundes "gegründet 1925"-Siegel – dezentes Detail oben rechts */
  .hero__seal {
    position: absolute;
    z-index: 1;
    top: var(--space-4);
    right: var(--space-4);
    width: 92px;
    height: 92px;
    display: grid;
    place-content: center;
    text-align: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: var(--color-white);
    border: 2px solid rgba(255, 255, 255, 0.55);
    font-family: var(--font-head);
    line-height: 1;
  }
  .hero__seal-year {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
  }
  .hero__seal-label {
    display: block;
    margin-top: 3px;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  @keyframes hero-kenburns {
    from { transform: scale(1.04); }
    to   { transform: scale(1.14) translate(-1.5%, -1%); }
  }

  /* Cinematisches, gestaffeltes Einblenden beim Laden */
  .hero__kicker,
  .hero__title,
  .hero__claim,
  .hero__lead,
  .hero__actions,
  .hero__sparten {
    opacity: 0;
    animation: hero-rise 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero__title   { animation-delay: 0.2s; }
  .hero__claim   { animation-delay: 0.45s; }
  .hero__lead    { animation-delay: 0.7s; }
  .hero__actions { animation-delay: 0.95s; }
  .hero__sparten { animation-delay: 1.15s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }

  /* Schwache/kleine Geräte: Dauer-Zoom (Ken Burns) kostet dort spürbar
     GPU/Akku – Foto steht, Einblenden bleibt. */
  @media (max-width: 767px) {
    .hero__bg {
      animation: none;
      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg { animation: none; }
    .hero__kicker,
    .hero__title,
    .hero__claim,
    .hero__lead,
    .hero__actions,
    .hero__sparten {
      opacity: 1;
      animation: none;
    }
  }

  /* Mobil: „1925"-Siegel ausblenden (stört auf kleinen Screens), CTAs volle Breite */
  @media (max-width: 640px) {
    .hero__seal { display: none; }
  }
  @media (max-width: 520px) {
    .hero__actions .btn { width: 100%; }
  }
</style>
