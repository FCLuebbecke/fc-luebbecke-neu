---
/**
 * Hero – Startseite (claude.md Abschnitt 6.2)
 * Stil: "Immersives Vollbild-Foto" – das echte Vereinsfoto füllt die volle
 * Breite, ein sattes Grün-Schleier sorgt für Kontrast. Inhalt mittig zentriert
 * und bewusst knapp (Spec 012): Titel, Claim, ein Button, vier Sparten-Links.
 * Was Logo (seit 1925) und Sparten-Block schon sagen, steht hier nicht noch
 * einmal. Bewusst der einzige dunkle, wuchtige Block der Seite.
 *
 * Das Foto ist 1:1 austauschbar (Prop `image`); Platzhalter funktioniert.
 */
interface Props {
  /** Pfad zum Hero-Foto. Platzhalter ist 1:1 austauschbar. */
  image?: string;
  imageAlt?: string;
}

import SparteIcon from "./SparteIcon.astro";

const {
  image = "/hero.jpg",
  imageAlt = "Luftaufnahme des Vereinsgeländes des FC Lübbecke im Abendlicht",
} = Astro.props;

/* Die vier Sportangebote als Signatur im Hero – „ein Verein, vier Sparten".
   Verlinkt auf die Sparten-Seiten (Laufsport extern). Icons wie im
   Sparten-Block (Inline-SVG, siehe SparteIcon.astro). */
const sparten = [
  { label: "Fußball", icon: "fussball", href: "/fussball/mannschaften" },
  { label: "Badminton", icon: "badminton", href: "/badminton/mannschaften" },
  { label: "Darts", icon: "darts", href: "/darts/mannschaften" },
  { label: "Laufsport", icon: "laufsport", href: "https://luebbecker-bergloewen.de/", external: true },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Foto füllt die volle Fläche. Standardbild: responsive WebP-Varianten,
       damit Handys nicht das 1920er-Bild laden; eigenes Bild via Prop = 1:1. -->
  {image === "/hero.jpg" ? (
    <picture>
      <source
        type="image/webp"
        srcset="/hero-768.webp 768w, /hero-1280.webp 1280w, /hero-1920.webp 1920w"
        sizes="100vw"
      />
      <img
        class="hero__bg"
        src="/hero-1920.jpg"
        alt={imageAlt}
        width="1920"
        height="1152"
        fetchpriority="high"
      />
    </picture>
  ) : (
    <img
      class="hero__bg"
      src={image}
      alt={imageAlt}
      width="2000"
      height="1200"
      fetchpriority="high"
    />
  )}
  <span class="hero__veil" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">FC Lübbecke</h1>

      <p class="hero__claim">Unser Verein. Unser Lübbecke.</p>

      <div class="hero__actions">
        <a class="btn btn--light" href="/mitglied-werden">Mitglied werden</a>
      </div>

      <!-- Signatur: ein Verein, vier Sparten – verlinkt -->
      <nav class="hero__sparten-nav" aria-label="Unsere vier Sportangebote">
        <ul class="hero__sparten">
          {sparten.map((s) => (
            <li>
              <a
                class="hero__sparte"
                href={s.href}
                target={"external" in s ? "_blank" : undefined}
                rel={"external" in s ? "noopener noreferrer" : undefined}
              >
                <span class="hero__sparte-icon" aria-hidden="true"><SparteIcon name={s.icon} /></span>
                <span>{s.label}</span>
                {"external" in s && <span aria-hidden="true">↗</span>}
                {"external" in s && <span class="sr-only"> (öffnet in neuem Fenster)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: clamp(30rem, 78vh, 46rem);
    overflow: hidden;
    background: var(--color-green-900);
  }

  /* Foto: füllt die Fläche, langsamer Ken-Burns-Zoom für Lebendigkeit */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 60% 45%;
    animation: hero-kenburns 28s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* Grün-Schleier: gleichmäßig dunkel für Textkontrast in der Mitte,
     dazu eine sanfte Vignette (außen dunkler) – Fokus zentriert. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        120% 95% at 50% 50%,
        rgba(8, 45, 13, 0.55) 0%,
        rgba(7, 38, 11, 0.78) 70%,
        rgba(6, 30, 10, 0.9) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 45, 13, 0.45) 0%,
        rgba(8, 45, 13, 0.55) 100%
      );
  }

  .hero__inner {
    position: relative;
    width: 100%;
    padding-block: var(--space-6);
  }

  .hero__content {
    width: 100%;
    color: var(--color-white);
  }


  .hero__title {
    font-size: clamp(3rem, 1.6rem + 7vw, 6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--color-white);
    text-shadow: 0 2px 24px rgba(6, 30, 10, 0.45);
  }

  .hero__claim {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-white);
    margin-top: var(--space-2);
    text-shadow: 0 1px 16px rgba(6, 30, 10, 0.4);
  }


  .hero__actions {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  /* ---- Sparten-Signatur (ein Verein, vier Sparten) ---- */
  .hero__sparten-nav {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .hero__sparten {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
  }
  .hero__sparte {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hero__sparte:hover,
  .hero__sparte:focus-visible {
    color: var(--color-white);
  }
  .hero__sparte:hover .hero__sparte-icon,
  .hero__sparte:focus-visible .hero__sparte-icon {
    background: var(--color-green-500);
    border-color: var(--color-green-500);
  }
  .hero__sparte:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }
  .hero__sparte-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
  }


  @keyframes hero-kenburns {
    from { transform: scale(1.04); }
    to   { transform: scale(1.14) translate(-1.5%, -1%); }
  }

  /* Einblenden beim Laden: Titel + Claim zuerst, der Rest kurz danach */
  .hero__title,
  .hero__claim,
  .hero__actions,
  .hero__sparten-nav {
    opacity: 0;
    animation: hero-rise 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero__actions,
  .hero__sparten-nav { animation-delay: 0.35s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }

  /* Schwache/kleine Geräte: Dauer-Zoom (Ken Burns) kostet dort spürbar
     GPU/Akku – Foto steht, Einblenden bleibt. */
  @media (max-width: 767px) {
    .hero__bg {
      animation: none;
      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg { animation: none; }
    .hero__title,
    .hero__claim,
    .hero__actions,
    .hero__sparten-nav {
      opacity: 1;
      animation: none;
    }
  }

  /* Mobil: CTA volle Breite */
  @media (max-width: 520px) {
    .hero__actions .btn { width: 100%; }
  }
</style>
