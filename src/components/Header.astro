---
/**
 * Header / Navigation (claude.md Abschnitt 5)
 * - Sticky, weiß, Logo links · Menü · "Mitglied werden" rechts
 * - Nur Fußball hat ein Untermenü
 * - Laufsport ist extern (neues Fenster, ↗)
 * - Mobil: Burger-Menü
 */
interface Props {
  /** Aktiver Menüpunkt (für die grüne Unterstreichung) */
  active?: string;
}
const { active = "start" } = Astro.props;

const nav = [
  { id: "start", label: "Start", href: "/" },
  {
    id: "fussball",
    label: "Fußball",
    href: "/fussball/mannschaften", // keine eigene Übersicht – direkt zu Mannschaften
    sub: [
      { label: "Mannschaften", href: "/fussball/mannschaften" },
      { label: "Spielplan", href: "/fussball/spielplan" },
      { label: "FCL LIVE – Livestream & Videos", href: "/live" },
      { label: "Jugendförderverein", href: "/fussball/foerderverein" },
      { label: "Kontakt", href: "/fussball/kontakt" },
    ],
  },
  {
    id: "badminton",
    label: "Badminton",
    href: "/badminton/mannschaften",
    sub: [
      { label: "Mannschaften", href: "/badminton/mannschaften" },
      { label: "Trainingszeiten", href: "/badminton/trainingszeiten" },
      { label: "Kontakt", href: "/badminton/kontakt" },
    ],
  },
  {
    id: "darts",
    label: "Darts",
    href: "/darts/mannschaften",
    sub: [
      { label: "Mannschaften", href: "/darts/mannschaften" },
      { label: "Trainingszeiten", href: "/darts/trainingszeiten" },
      { label: "Kontakt", href: "/darts/kontakt" },
    ],
  },
  {
    id: "laufsport",
    label: "Laufsport",
    href: "https://luebbecker-bergloewen.de/", // Lübbecker Berglöwen (extern)
    external: true,
  },
  // "Verein/Über uns" gestrichen; Kontakt liegt im "Mitglied werden"-Block (#mitglied-werden)
];
---

<header class="header">
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

  <div class="container header__bar">
    <!-- Logo -->
    <a class="header__logo" href="/" aria-label="FC Lübbecke – zur Startseite">
      <img src="/logo.png" alt="FC Lübbecke e.V." width="1024" height="205" />
    </a>

    <!-- Burger (mobil) -->
    <button
      class="header__burger"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="hauptnavigation"
    >
      <span class="header__burger-box" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <!-- Navigation -->
    <nav class="nav" id="hauptnavigation" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={["nav__item", { "nav__item--has-sub": item.sub }]}>
            <a
              class:list={["nav__link", { "is-active": item.id === active }]}
              href={item.href}
              aria-current={item.id === active ? "page" : undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              aria-expanded={item.sub ? "false" : undefined}
            >
              {item.label}
              {item.external && (
                <svg class="nav__ext" viewBox="0 0 10 10" width="9" height="9" aria-hidden="true">
                  <path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {item.external && <span class="sr-only"> (öffnet in neuem Fenster)</span>}
              {item.sub && (
                <svg class="nav__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                  <path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {item.sub && (
              <ul class="nav__sub">
                {item.sub.map((s) => (
                  <li>
                    <a class="nav__sublink" href={s.href}>{s.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}

        <!-- CTA im Menü (mobil sichtbar) -->
        <li class="nav__item nav__item--cta">
          <a class="btn btn--primary" href="/mitglied-werden">Mitglied werden</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid rgba(10, 80, 18, 0.12);
    box-shadow: none;
    transition: box-shadow 0.2s ease;
  }
  .header.is-scrolled {
    box-shadow: 0 2px 14px rgba(10, 80, 18, 0.10);
  }

  /* schmaler grüner Markenstreifen ganz oben */
  .header::before {
    content: "";
    display: block;
    height: 4px;
    background: var(--color-green-700);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 72px;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .header__logo img {
    height: 38px;
    width: auto;
  }

  /* ---- Navigation (Desktop) ---- */
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    min-height: var(--tap);
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-green-900);
    text-decoration: none;
    border-radius: var(--radius-sm);
    position: relative;
    transition: color 0.15s ease;
  }
  .nav__link:hover {
    color: var(--color-green-700);
  }

  /* Akzentgrüne Unterstreichung: aktiv = sichtbar, Hover = wächst von links
     (claude.md Abschnitt 5) */
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.28rem;
    height: 3px;
    background: var(--color-green-500);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }
  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  /* Pfeile als SVG: knackig statt winziger Font-Glyphen, optisch mittig */
  .nav__ext {
    flex: none;
    margin-top: -2px;
    opacity: 0.85;
  }
  .nav__caret {
    flex: none;
    margin-top: 1px;
    opacity: 0.7;
    transition: transform 0.18s ease;
  }
  /* Chevron dreht sich, wenn das Dropdown aufgeht */
  .nav__item--has-sub:hover > .nav__link .nav__caret,
  .nav__item--has-sub:focus-within > .nav__link .nav__caret {
    transform: rotate(180deg);
  }

  /* ---- Untermenü Fußball (Desktop: Dropdown) ---- */
  .nav__item--has-sub { position: relative; }

  .nav__sub {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.12);
    border-top: 3px solid var(--color-green-500);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: var(--shadow-card);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .nav__item--has-sub:hover .nav__sub,
  .nav__item--has-sub:focus-within .nav__sub {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__sublink {
    display: block;
    padding: 0.6rem 0.75rem;
    min-height: var(--tap);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: var(--fs-body);
    text-decoration: none;
  }
  .nav__sublink:hover {
    background: var(--color-green-050);
    color: var(--color-green-700);
    box-shadow: inset 3px 0 0 var(--color-green-500);
  }

  /* CTA klar von der Navigation absetzen */
  .nav__item--cta { margin-left: 1.25rem; }

  /* ---- Burger ---- */
  .header__burger {
    display: none;
    background: transparent;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .header__burger-box {
    display: block;
    width: 26px;
    height: 18px;
    position: relative;
  }
  .header__burger-box span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-green-900);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease, top 0.2s ease;
  }
  .header__burger-box span:nth-child(1) { top: 0; }
  .header__burger-box span:nth-child(2) { top: 7.5px; }
  .header__burger-box span:nth-child(3) { top: 15px; }

  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(1) {
    top: 7.5px; transform: rotate(45deg);
  }
  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(2) {
    opacity: 0;
  }
  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(3) {
    top: 7.5px; transform: rotate(-45deg);
  }

  /* ---- Skip-Link (Barrierefreiheit) ---- */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-green-700);
    color: #fff;
    padding: 0.6rem 1rem;
    z-index: 200;
    border-radius: 0 0 var(--radius-sm) 0;
  }
  .skip-link:focus { left: 0; }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* =========================================================
     Mobil: Burger-Menü (claude.md Abschnitt 9: Mobil zuerst)
     ========================================================= */
  @media (max-width: 859px) {
    .header__burger { display: inline-flex; }

    .nav {
      position: fixed;
      inset: calc(72px + 4px) 0 0 0; /* unter dem Header (4px Streifen + 72px Leiste) */
      background: var(--color-white);
      padding: var(--space-3);
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.22s ease;
      visibility: hidden;
    }
    .nav.is-open {
      transform: translateX(0);
      visibility: visible;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .nav__link {
      display: flex;
      width: 100%;
      font-size: 1.1rem;
      padding: 0.85rem 0.6rem;
      border-bottom: 1px solid rgba(10, 80, 18, 0.08);
      border-radius: 0;
    }
    .nav__link::after { display: none; }
    .nav__link.is-active {
      color: var(--color-green-700);
      border-left: 4px solid var(--color-green-500);
      padding-left: 0.85rem;
    }

    /* Untermenü mobil: standardmäßig EINGEKLAPPT, per Tippen aufklappen */
    .nav__sub {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      padding: 0 0 0.4rem 1rem;
      min-width: 0;
      display: none;
    }
    .nav__item.is-sub-open > .nav__sub { display: block; }

    /* Pfeil rechts, dreht sich beim Aufklappen */
    .nav__caret {
      display: inline-block;
      margin-left: auto;
      width: 13px;
      height: 8px;
      transition: transform 0.2s ease;
    }
    .nav__item.is-sub-open > .nav__link .nav__caret { transform: rotate(180deg); }

    .nav__item--cta {
      margin: var(--space-3) 0 0;
    }
    .nav__item--cta .btn { width: 100%; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>(".header__burger");
  const nav = document.querySelector<HTMLElement>("#hauptnavigation");

  // Schatten erst, wenn die Seite gescrollt ist (oben bleibt der Header flach)
  const header = document.querySelector<HTMLElement>(".header");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  document.addEventListener("scroll", onScroll, { passive: true });

  function setOpen(open: boolean) {
    if (!burger || !nav) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    nav.classList.toggle("is-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  }

  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    setOpen(!open);
  });

  // Schließen mit Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Bei Wechsel auf Desktop zurücksetzen
  const mq = window.matchMedia("(min-width: 860px)");
  mq.addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });

  // Untermenüs auf dem Handy ein-/ausklappen (Desktop: Hover-Dropdown, unverändert)
  const mqMobile = window.matchMedia("(max-width: 859px)");
  document
    .querySelectorAll<HTMLAnchorElement>(".nav__item--has-sub > .nav__link")
    .forEach((link) => {
      link.addEventListener("click", (e) => {
        if (!mqMobile.matches) return; // Desktop: normaler Link
        e.preventDefault();
        const item = link.parentElement as HTMLElement;
        const open = item.classList.toggle("is-sub-open");
        link.setAttribute("aria-expanded", String(open));
      });
    });

  // Beim Wechsel auf Desktop alle aufgeklappten Untermenüs zurücksetzen
  mq.addEventListener("change", (e) => {
    if (!e.matches) return;
    document.querySelectorAll(".nav__item.is-sub-open").forEach((item) => {
      item.classList.remove("is-sub-open");
      item.querySelector(".nav__link")?.setAttribute("aria-expanded", "false");
    });
  });
</script>
