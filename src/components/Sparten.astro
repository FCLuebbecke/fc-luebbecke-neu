---
/**
 * Sparten-Block (claude.md Abschnitt 6.3 + 8)
 * Kernregel: Fußball oben groß (volle Breite), darunter Badminton · Darts ·
 * Laufsport ↗ als drei gleichwertige Karten. So dominiert Fußball, ohne die
 * kleineren Sparten zurückzusetzen.
 *
 * Stil an den Hero angeglichen: versetztes Akzent-Band hinter der Fußball-
 * Karte, dezenter Grün-Schleier auf dem Foto, gestaffeltes Einblenden beim
 * Scrollen. Ohne JS / bei "reduce" sind alle Inhalte sofort sichtbar.
 */
const LAUFSPORT_URL = "https://luebbecker-bergloewen.de/";

/**
 * Sparten-Icons aus „Flaticon UIcons" (Stil Bold Rounded), als Icon-Font per
 * CDN eingebunden (siehe Layout.astro). Klassen-Schema: `fi fi-br-<name>`.
 * Werden über `color`/`font-size` gesteuert → übernehmen das Vereinsgrün und
 * die Hover-Animation. Dekorativ → aria-hidden (der Kartentitel benennt die Sparte).
 * Lizenz: Free-Tier mit Attribution (Hinweis im Footer).
 */
const kleineSparten = [
  {
    label: "Sparte",
    title: "Badminton",
    text: "Schnell, dynamisch und für jedes Alter. Trainiere mit uns in der Halle – ganz unverbindlich zum Schnuppern.",
    icon: "fi-br-shuttlecock",
    href: "/badminton/mannschaften",
    cta: "Zum Badminton",
  },
  {
    label: "Sparte",
    title: "Darts",
    text: "Präzision trifft Gemeinschaft. Ob Anfänger oder Routinier – wirf mit und werde Teil der Runde.",
    icon: "fi-br-bullseye-arrow",
    href: "/darts/mannschaften",
    cta: "Zu Darts",
  },
  {
    label: "Extern",
    title: "Laufsport",
    text: "Die Lübbecker Berglöwen – unsere Laufgruppe für alle, die gern an der frischen Luft unterwegs sind.",
    icon: "fi-br-running",
    href: LAUFSPORT_URL,
    cta: "Zur Website",
    external: true,
  },
];
---

<section class="sparten" id="sparten" aria-labelledby="sparten-title">
  <div class="container">
    <header class="sparten__head">
      <h2 id="sparten-title" class="section-title">Unsere Sparten</h2>
      <p class="sparten__intro">
        Ein Verein, vier Wege, aktiv zu sein. Such dir aus, was zu dir passt –
        willkommen bist du überall.
      </p>
    </header>

    <!-- Fußball: große Karte über volle Breite -->
    <div class="feature-wrap">
      <span class="feature-wrap__band" aria-hidden="true"></span>
      <article class="card card--feature">
        <div class="card--feature__media">
          <img
            src="/sparte-fussball.webp"
            alt="Abgenutzter Fußball auf dem taubedeckten Rasen des Vereinsplatzes"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <span class="card--feature__overlay" aria-hidden="true"></span>
        </div>
        <div class="card--feature__body">
          <span class="tag tag--strong">Größte Sparte</span>
          <h3 class="card__title">Fußball</h3>
          <p class="card__text">
            Von den Minis bis zu den Senioren: Bei uns spielt der ganze Verein.
            Mehrere Mannschaften, festes Training und echtes Vereinsleben –
            komm vorbei und schnür die Schuhe.
          </p>
          <a class="btn btn--primary" href="/fussball/mannschaften">Zur Fußball-Abteilung</a>
        </div>
      </article>
    </div>

    <!-- Badminton · Darts · Laufsport: drei gleichwertige Karten -->
    <div class="sparten__grid">
      {kleineSparten.map((s, i) => (
        <article class="card">
          <div class="card__icon">
            <i class:list={["fi", s.icon]} aria-hidden="true"></i>
          </div>
          <div class="card__body">
            <span class:list={["tag", { "tag--ext": s.external }]}>{s.label}</span>
            <h3 class="card__title">
              {s.title}
              {s.external && <span class="card__ext" aria-hidden="true">↗</span>}
            </h3>
            <p class="card__text">{s.text}</p>
            <a
              class="btn btn--secondary"
              href={s.href}
              target={s.external ? "_blank" : undefined}
              rel={s.external ? "noopener noreferrer" : undefined}
            >
              {s.cta}
              {s.external && <span aria-hidden="true"> ↗</span>}
              {s.external && <span class="sr-only"> (öffnet in neuem Fenster)</span>}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sparten {
    background: var(--color-white);
    padding-block: var(--space-6);
    scroll-margin-top: 88px; /* sticky Header beim Ankersprung nicht überdecken */
  }

  .sparten__head {
    margin-bottom: var(--space-4);
  }
  .sparten__intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
    max-width: 60ch;
  }

  /* ---- Karten-Grundform (claude.md Abschnitt 8) ---- */
  .card {
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(10, 80, 18, 0.16);
  }

  .card--feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- Icon-Panel der drei kleinen Karten ----
     Hellgrüne Fläche + weißes „Badge" + grünes Line-Icon. */
  .card__icon {
    position: relative;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    color: var(--color-green-700);
    background:
      radial-gradient(120% 120% at 30% 22%, #ffffff 0%, transparent 58%),
      var(--color-green-050);
    border-bottom: 1px solid rgba(10, 80, 18, 0.08);
  }
  /* weißes rundes Badge hinter dem Icon */
  .card__icon::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: var(--color-white);
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card__icon i {
    position: relative;
    z-index: 1;
    display: block;
    line-height: 1;
    font-size: clamp(46px, 22%, 66px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  .card:hover .card__icon::before {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .card:hover .card__icon i {
    transform: scale(1.1) rotate(-3deg);
    color: var(--color-green-900);
  }

  .card__body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .card__title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .card__ext { color: var(--color-green-700); font-size: 0.8em; }

  .card__text {
    color: var(--color-muted);
    flex: 1;
  }
  .card__body .btn {
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  /* ---- Sparten-Etiketten (abgestufte Grüntöne) ---- */
  .tag {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--color-green-050);
    color: var(--color-green-700);
  }
  .tag--strong {
    background: var(--color-green-700);
    color: #fff;
  }
  .tag--ext {
    background: #fff;
    color: var(--color-green-700);
    border: 1px solid var(--color-green-500);
  }

  /* ---- Fußball-Feature-Karte (volle Breite) ---- */
  /* Wrapper trägt das versetzte Akzent-Band (wie im Hero) */
  .feature-wrap {
    position: relative;
    isolation: isolate;
    margin-bottom: var(--space-4);
  }
  .feature-wrap__band {
    position: absolute;
    z-index: 0;
    inset: 18px -16px -16px 18px; /* nach unten-rechts versetzt */
    background: var(--color-green-500);
    border-radius: var(--radius-md);
  }

  .card--feature {
    position: relative;
    z-index: 1;
    flex-direction: column;
    margin: 0;
  }
  .card--feature__media {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  /* dezenter Grün-Schleier für mehr Tiefe (claude.md Abschnitt 8) */
  .card--feature__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(10, 80, 18, 0.42) 0%,
      rgba(10, 80, 18, 0) 45%
    );
  }
  .card--feature__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .card--feature .card__title {
    font-size: var(--fs-h2);
  }
  .card--feature__body .card__text {
    max-width: 60ch;
  }

  /* ---- Drei-Karten-Raster ---- */
  .sparten__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* ---- Desktop ---- */
  @media (min-width: 760px) {
    .sparten__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  @media (min-width: 900px) {
    /* Fußball-Karte: Bild und Text nebeneinander */
    .card--feature {
      flex-direction: row;
      align-items: stretch;
    }
    .card--feature__media {
      flex: 1 1 56%;
      aspect-ratio: auto;
    }
    .card--feature__body {
      flex: 1 1 44%;
      justify-content: center;
      padding: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
    .card:hover .card__icon::before { transform: translate(-50%, -50%); }
    .card:hover .card__icon i { transform: none; }
  }
</style>
