---
/**
 * Instagram-Feed mit DSGVO-konformer 2-Klick-Lösung (claude.md Abschnitt 10).
 * Ersetzt den klassischen News-Block: zeigt die neuesten Fußball-Beiträge.
 *
 * Daten: Behold.so-API (src/lib/instagram.ts), geholt zur BUILD-ZEIT –
 * es entsteht KEINE Laufzeit-Verbindung zu Meta. Die Bilder werden dennoch
 * erst nach aktiver Zustimmung geladen (data-src → src) und die Zustimmung
 * in localStorage gemerkt.
 */
import { getInstagramPosts } from "../lib/instagram";

interface Props {
  handle?: string;
  profileUrl?: string;
}
const {
  handle = "@fcluebbecke", // TODO: echten Fußball-Handle bestätigen
  profileUrl = "https://www.instagram.com/fcluebbecke/", // TODO: echte Profil-URL bestätigen
} = Astro.props;

const posts = await getInstagramPosts(6);
---

<section class="ig" aria-labelledby="ig-title">
  <div class="container">
    <header class="ig__head">
      <h2 id="ig-title" class="section-title">Aktuelles auf Instagram</h2>
      <p class="ig__intro">
        Die neuesten Eindrücke aus unserer Fußball-Abteilung – Spiele, Tore,
        Vereinsleben. Folge uns für alles, was rund um den Platz passiert.
      </p>
    </header>

    <div class="ig__widget" data-ig-widget>
      <!-- Zustimmungs-Ansicht (vor dem Laden) -->
      <div class="ig__consent" data-ig-consent>
        <span class="ig__glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        <h3 class="ig__consent-title">Instagram-Beiträge anzeigen</h3>
        <p class="ig__consent-text">
          Hier zeigen wir unsere neuesten Instagram-Beiträge. Beim Laden werden
          die Bilder nachgeladen und dabei können personenbezogene Daten
          (z. B. deine IP-Adresse) an Dritte übertragen werden. Mehr dazu in
          unserer <a href="/datenschutz">Datenschutzerklärung</a>.
        </p>
        <div class="ig__consent-actions">
          <button class="btn btn--primary" type="button" data-ig-load>
            Beiträge laden
          </button>
          <a
            class="btn btn--secondary"
            href={profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Direkt auf Instagram ansehen <span aria-hidden="true">↗</span>
            <span class="sr-only"> (öffnet in neuem Fenster)</span>
          </a>
        </div>
        <label class="ig__remember">
          <input type="checkbox" data-ig-remember checked />
          Zustimmung für künftige Besuche merken
        </label>
      </div>

      <!-- Feed-Grid: nach Zustimmung sichtbar; Bilder erst dann nachgeladen -->
      {posts.length > 0 ? (
        <ul class="ig__grid" data-ig-embed hidden>
          {posts.map((p) => (
            <li class="ig__item">
              <a href={p.permalink} target="_blank" rel="noopener noreferrer">
                <img
                  data-src={p.sizes.medium.mediaUrl}
                  alt={(p.prunedCaption ?? p.caption ?? "Instagram-Beitrag des FC Lübbecke").slice(0, 140)}
                  width={p.sizes.medium.width}
                  height={p.sizes.medium.height}
                  loading="lazy"
                />
                {p.mediaType === "VIDEO" && <span class="ig__badge" aria-hidden="true">▶</span>}
                {p.mediaType === "CAROUSEL_ALBUM" && <span class="ig__badge" aria-hidden="true">▦</span>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="ig__embed-note" data-ig-embed hidden>
          <p>Aktuell konnten keine Beiträge geladen werden. Schau direkt auf unserem Profil vorbei.</p>
        </div>
      )}
    </div>

    <div class="ig__follow">
      <a class="btn btn--primary" href={profileUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">📸</span> Auf Instagram folgen ({handle})
        <span class="sr-only"> (öffnet in neuem Fenster)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ig {
    background: var(--color-green-050);
    padding-block: var(--space-6);
  }

  .ig__head { margin-bottom: var(--space-4); }
  .ig__intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .ig__widget {
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    min-height: 280px;
    display: flex;
  }

  /* ---- Zustimmungs-Ansicht ---- */
  .ig__consent {
    margin: auto;
    max-width: 52ch;
    text-align: center;
    padding: var(--space-5) var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .ig__glyph {
    display: inline-grid;
    place-items: center;
    width: 64px; height: 64px;
    border-radius: var(--radius-md);
    color: #fff;
    background: linear-gradient(135deg, #0a6e12, #16a626);
  }
  .ig__consent-title { color: var(--color-green-900); }
  .ig__consent-text {
    color: var(--color-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .ig__consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: 0.3rem;
  }
  .ig__remember {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    cursor: pointer;
  }

  /* ---- Geladener Feed (natives Grid) ---- */
  .ig__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
  }
  .ig__item { position: relative; margin: 0; }
  .ig__item a {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .ig__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ig__item a:hover img { transform: scale(1.05); }
  .ig__badge {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    color: #fff;
    font-size: 0.95rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  .ig__embed-note {
    margin: auto;
    padding: var(--space-4);
    text-align: center;
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .ig__follow {
    margin-top: var(--space-4);
    text-align: center;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (min-width: 640px) {
    .ig__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  const STORAGE_KEY = "ig-consent-fcl";

  document.querySelectorAll<HTMLElement>("[data-ig-widget]").forEach((widget) => {
    const consent = widget.querySelector<HTMLElement>("[data-ig-consent]");
    const embed = widget.querySelector<HTMLElement>("[data-ig-embed]");
    const loadBtn = widget.querySelector<HTMLButtonElement>("[data-ig-load]");
    const remember = widget.querySelector<HTMLInputElement>("[data-ig-remember]");

    function showFeed() {
      if (!consent || !embed) return;
      // Bilder erst jetzt laden: data-src → src
      embed.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
        img.src = img.dataset.src || "";
        img.removeAttribute("data-src");
      });
      consent.hidden = true;
      embed.hidden = false;
    }

    // Bereits zugestimmt? Dann direkt laden.
    try {
      if (localStorage.getItem(STORAGE_KEY) === "yes") showFeed();
    } catch {}

    loadBtn?.addEventListener("click", () => {
      if (remember?.checked) {
        try { localStorage.setItem(STORAGE_KEY, "yes"); } catch {}
      }
      showFeed();
    });
  });
</script>
