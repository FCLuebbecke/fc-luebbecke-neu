---
/**
 * Instagram-Feed: zeigt die neuesten Fußball-Beiträge als volles Raster.
 *
 * Daten: Behold.so-API (src/lib/instagram.ts), geholt zur BUILD-ZEIT.
 * Die Einwilligung (DSGVO) wird NICHT mehr hier per 2-Klick geregelt,
 * sondern zentral über das Cookie-/Consent-Banner der Seite.
 */
import { getInstagramPosts } from "../lib/instagram";

interface Props {
  handle?: string;
  profileUrl?: string;
}
const {
  handle = "@fcluebbecke", // TODO: echten Fußball-Handle bestätigen
  profileUrl = "https://www.instagram.com/fcluebbecke/", // TODO: echte Profil-URL bestätigen
} = Astro.props;

const posts = await getInstagramPosts(6);

// Bild-Quelle je Post: Beholds Proxy-URLs (p.sizes.*) liefern für diesen Feed
// nur noch HTTP 400 ("Missing Instagram src") – daher direkt die Instagram-
// CDN-URLs nutzen. Bei Videos ist mediaUrl die Videodatei, also thumbnailUrl.
function bildUrl(p: (typeof posts)[number]): string {
  return (p.mediaType === "VIDEO" ? p.thumbnailUrl : undefined) ?? p.mediaUrl;
}
---

<section class="ig" aria-labelledby="ig-title">
  <div class="container">
    <header class="ig__head">
      <h2 id="ig-title" class="section-title">Aktuelles auf Instagram</h2>
      <p class="ig__intro">
        Die neuesten Eindrücke aus unserer Fußball-Abteilung – Spiele, Tore,
        Vereinsleben. Folge uns für alles, was rund um den Platz passiert.
      </p>
    </header>

    <div class="ig__widget">
      {posts.length > 0 ? (
        <ul class="ig__grid">
          {posts.map((p) => (
            <li class="ig__item">
              <a href={p.permalink} target="_blank" rel="noopener noreferrer">
                <img
                  src={bildUrl(p)}
                  alt={(p.prunedCaption ?? p.caption ?? "Instagram-Beitrag des FC Lübbecke").slice(0, 140)}
                  width={p.sizes?.medium?.width ?? 640}
                  height={p.sizes?.medium?.height ?? 640}
                  loading="lazy"
                />
                {p.mediaType === "VIDEO" && <span class="ig__badge" aria-hidden="true">▶</span>}
                {p.mediaType === "CAROUSEL_ALBUM" && <span class="ig__badge" aria-hidden="true">▦</span>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="ig__embed-note">
          <p>Aktuell konnten keine Beiträge geladen werden. Schau direkt auf unserem Profil vorbei.</p>
        </div>
      )}
    </div>

    <div class="ig__follow">
      <a class="btn btn--primary" href={profileUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">📸</span> Auf Instagram folgen ({handle})
        <span class="sr-only"> (öffnet in neuem Fenster)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ig {
    background: var(--color-green-050);
    padding-block: var(--space-6);
  }

  .ig__head { margin-bottom: var(--space-4); }
  .ig__intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .ig__widget {
    position: relative;
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* ---- Raster: füllt die ganze Card (3×2 Desktop, 2×3 Mobil) ---- */
  .ig__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
  }
  .ig__item { position: relative; margin: 0; }
  .ig__item a {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-green-050); /* Platzhalter, bis Bild geladen */
  }
  .ig__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ig__item a:hover img { transform: scale(1.05); }
  .ig__badge {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    color: #fff;
    font-size: 0.95rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .ig__embed-note {
    padding: var(--space-5) var(--space-4);
    text-align: center;
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .ig__follow {
    margin-top: var(--space-4);
    text-align: center;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (min-width: 640px) {
    .ig__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
