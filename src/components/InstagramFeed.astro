---
/**
 * Instagram-Feed mit DSGVO-konformer 2-Klick-Lösung (claude.md Abschnitt 10).
 * Ersetzt den klassischen News-Block: zeigt die neuesten Fußball-Beiträge.
 *
 * Instagram lädt ERST nach aktiver Zustimmung. Die Zustimmung wird in
 * localStorage gemerkt, sodass der Feed bei weiteren Besuchen direkt erscheint.
 *
 * Einrichtung (vom Verein zu liefern):
 *  - handle / profileUrl: der Fußball-Instagram-Account
 *  - widgetSrc: iframe-URL des Feed-Widgets (z. B. von lightwidget.com)
 */
interface Props {
  handle?: string;
  profileUrl?: string;
  /** iframe-URL des Feed-Widgets. Solange leer → Hinweis statt Feed. */
  widgetSrc?: string;
}

const {
  handle = "@fcluebbecke", // TODO: echten Fußball-Handle eintragen
  profileUrl = "https://www.instagram.com/fcluebbecke/", // TODO: echte Profil-URL
  widgetSrc = "", // TODO: LightWidget-iframe-URL eintragen
} = Astro.props;
---

<section class="ig" aria-labelledby="ig-title">
  <div class="container">
    <header class="ig__head">
      <h2 id="ig-title" class="section-title">Aktuelles auf Instagram</h2>
      <p class="ig__intro">
        Die neuesten Eindrücke aus unserer Fußball-Abteilung – Spiele, Tore,
        Vereinsleben. Folge uns für alles, was rund um den Platz passiert.
      </p>
    </header>

    <div
      class="ig__widget"
      data-ig-widget
      data-ig-src={widgetSrc}
      data-ig-title={`Instagram-Feed von ${handle}`}
    >
      <!-- Zustimmungs-Ansicht (vor dem Laden) -->
      <div class="ig__consent" data-ig-consent>
        <span class="ig__glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        <h3 class="ig__consent-title">Instagram-Beiträge anzeigen</h3>
        <p class="ig__consent-text">
          Hier zeigen wir unsere neuesten Instagram-Beiträge. Beim Laden wird eine
          Verbindung zu Instagram (Meta Platforms) hergestellt und dabei können
          personenbezogene Daten (z. B. deine IP-Adresse) übertragen werden.
          Mehr dazu in unserer <a href="/datenschutz">Datenschutzerklärung</a>.
        </p>
        <div class="ig__consent-actions">
          <button class="btn btn--primary" type="button" data-ig-load>
            Beiträge laden
          </button>
          <a
            class="btn btn--secondary"
            href={profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Direkt auf Instagram ansehen <span aria-hidden="true">↗</span>
            <span class="sr-only"> (öffnet in neuem Fenster)</span>
          </a>
        </div>
        <label class="ig__remember">
          <input type="checkbox" data-ig-remember checked />
          Zustimmung für künftige Besuche merken
        </label>
      </div>

      <!-- Hierhin wird der Feed nach Zustimmung geladen -->
      <div class="ig__embed" data-ig-embed hidden></div>
    </div>

    <div class="ig__follow">
      <a class="btn btn--primary" href={profileUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">📸</span> Auf Instagram folgen ({handle})
        <span class="sr-only"> (öffnet in neuem Fenster)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ig {
    background: var(--color-green-050);
    padding-block: var(--space-6);
  }

  .ig__head { margin-bottom: var(--space-4); }
  .ig__intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .ig__widget {
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    min-height: 280px;
    display: flex;
  }

  /* ---- Zustimmungs-Ansicht ---- */
  .ig__consent {
    margin: auto;
    max-width: 52ch;
    text-align: center;
    padding: var(--space-5) var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .ig__glyph {
    display: inline-grid;
    place-items: center;
    width: 64px; height: 64px;
    border-radius: var(--radius-md);
    color: #fff;
    background: linear-gradient(135deg, #0a6e12, #16a626);
  }
  .ig__consent-title { color: var(--color-green-900); }
  .ig__consent-text {
    color: var(--color-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .ig__consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: 0.3rem;
  }
  .ig__remember {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    cursor: pointer;
  }

  /* ---- Geladener Feed ---- */
  .ig__embed { width: 100%; }
  .ig__embed :global(iframe) {
    width: 100%;
    border: 0;
    display: block;
    min-height: 480px;
  }
  .ig__embed-note {
    padding: var(--space-4);
    text-align: center;
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .ig__follow {
    margin-top: var(--space-4);
    text-align: center;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  const STORAGE_KEY = "ig-consent-fcl";

  document.querySelectorAll<HTMLElement>("[data-ig-widget]").forEach((widget) => {
    const consent = widget.querySelector<HTMLElement>("[data-ig-consent]");
    const embed = widget.querySelector<HTMLElement>("[data-ig-embed]");
    const loadBtn = widget.querySelector<HTMLButtonElement>("[data-ig-load]");
    const remember = widget.querySelector<HTMLInputElement>("[data-ig-remember]");
    const src = widget.getAttribute("data-ig-src") || "";
    const title = widget.getAttribute("data-ig-title") || "Instagram-Feed";

    function showFeed() {
      if (!consent || !embed) return;
      if (src) {
        const iframe = document.createElement("iframe");
        iframe.src = src;
        iframe.title = title;
        iframe.loading = "lazy";
        iframe.setAttribute("scrolling", "no");
        embed.appendChild(iframe);
      } else {
        // Noch kein Widget hinterlegt – ehrlicher Hinweis statt leerem Kasten.
        const note = document.createElement("p");
        note.className = "ig__embed-note";
        note.textContent =
          "Instagram-Feed noch nicht eingerichtet. Sobald die Widget-URL hinterlegt ist, erscheinen hier die neuesten Beiträge.";
        embed.appendChild(note);
      }
      consent.hidden = true;
      embed.hidden = false;
    }

    // Bereits zugestimmt? Dann direkt laden.
    try {
      if (localStorage.getItem(STORAGE_KEY) === "yes") showFeed();
    } catch {}

    loadBtn?.addEventListener("click", () => {
      if (remember?.checked) {
        try { localStorage.setItem(STORAGE_KEY, "yes"); } catch {}
      }
      showFeed();
    });
  });
</script>
