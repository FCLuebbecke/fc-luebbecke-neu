---
/**
 * Footer (claude.md Abschnitt 6.7)
 * Spalte 1: Logo + kurzer Vereinssatz
 * Spalte 2: alle Sparten als Textlinks (inkl. Laufsport ↗)
 * Spalte 3: Service (Satzung & Anträge als PDF, Mitgliederantrag → DFBnet)
 * Spalte 4: Social Media
 * Unterste Zeile: Impressum · Datenschutz (Pflicht)
 * ⚠️ Anschrift/Kontakt/Social-Links sind Platzhalter – später ersetzen.
 */
const LAUFSPORT_URL = "https://luebbecker-bergloewen.de/";
const jahr = 2026; // currentDate; Build-Datum bei Veröffentlichung anpassen

const sparten = [
  { label: "Fußball", href: "/fussball/mannschaften" },
  { label: "Badminton", href: "/badminton/mannschaften" },
  { label: "Darts", href: "/darts/mannschaften" },
  { label: "Laufsport", href: LAUFSPORT_URL, external: true },
];

const verein = [
  { label: "Mitglied werden", href: "/mitglied-werden" },
];

// Service-Downloads (PDFs von der alten Vereinsseite übernommen, liegen in
// public/service/). Der Mitgliederantrag ist ein Online-Formular beim DFBnet.
const service = [
  { label: "Vereinssatzung (PDF)", href: "/service/vereinssatzung.pdf", external: true },
  { label: "Mitgliederantrag", href: "https://verein.dfbnet.org/mitgliedsantrag/fcluebbecke", external: true },
  { label: "Passantrag (PDF)", href: "/service/passantrag.pdf", external: true },
  { label: "Stellv. Abmeldung (PDF)", href: "/service/stellvertretende-abmeldung.pdf", external: true },
];

const social = [
  { label: "Instagram", href: "https://www.instagram.com/fcluebbecke/", icon: "instagram" },
  { label: "Facebook", href: "https://www.facebook.com/FcLuebbecke", icon: "facebook" },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <!-- Spalte 1: Logo + Vereinssatz -->
    <div class="footer__brand">
      <img class="footer__logo" src="/logo.png" alt="FC Lübbecke e.V." width="1024" height="205" />
      <p class="footer__claim">
        Seit 1925 unser Verein, unser Lübbecke. Vier Sparten,
        ein gemeinsamer Auftritt – Fußball, Badminton, Darts und Laufsport.
      </p>
    </div>

    <!-- Spalte 2: Sparten -->
    <nav class="footer__col" aria-label="Sparten">
      <h2 class="footer__title">Sparten</h2>
      <ul class="footer__links">
        {sparten.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.external ? "_blank" : undefined}
              rel={s.external ? "noopener noreferrer" : undefined}
            >
              {s.label}
              {s.external && <span aria-hidden="true"> ↗</span>}
              {s.external && <span class="sr-only"> (öffnet in neuem Fenster)</span>}
            </a>
          </li>
        ))}
        {verein.map((v) => (
          <li><a href={v.href}>{v.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Spalte 3: Service (Satzung, Anträge) -->
    <nav class="footer__col" aria-label="Service">
      <h2 class="footer__title">Service</h2>
      <ul class="footer__links">
        {service.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only"> (öffnet in neuem Fenster)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Spalte 4: Social Media -->
    <nav class="footer__col" aria-label="Social Media">
      <h2 class="footer__title">Folge uns</h2>
      <ul class="footer__links footer__links--social">
        {social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              <span class="footer__icon" aria-hidden="true">
                {s.icon === "instagram" && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {s.icon === "facebook" && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                    <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5Z" />
                  </svg>
                )}
              </span>
              {s.label}
              <span class="sr-only"> (öffnet in neuem Fenster)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Pflichtzeile: Impressum · Datenschutz -->
  <div class="footer__legal">
    <div class="container footer__legal-bar">
      <div class="footer__copy">
        <p>© {jahr} FC Lübbecke e.V.</p>
      </div>
      <ul class="footer__legal-links">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-green-900);
    color: rgba(255, 255, 255, 0.85);
    /* Akzentkante oben: Gegenstück zum Vereinsband im Header */
    border-top: 4px solid var(--color-green-500);
  }

  .footer__grid {
    display: grid;
    /* Mobil: Link-Spalten nebeneinander statt alles untereinander – spart Höhe */
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-3);
    padding-block: var(--space-5) var(--space-4);
  }
  /* Marke (Logo + Vereinssatz) steht oben über die volle Breite */
  .footer__brand {
    grid-column: 1 / -1;
  }

  .footer__logo {
    height: 44px;
    width: auto;
    /* Logo ist farbig; auf dunklem Grund leicht hervorheben */
    background: #fff;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
  }
  .footer__claim {
    margin-top: var(--space-3);
    max-width: 46ch;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .footer__title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: var(--space-2);
  }
  /* grüner Balken vor dem Titel – gleiches Motiv wie .section-title im Inhalt */
  .footer__title::before {
    content: "";
    width: 14px;
    height: 3px;
    background: var(--color-green-500);
    border-radius: 2px;
    flex: none;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer__links a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .footer__links a:hover {
    color: #fff;
    text-decoration: underline;
  }
  /* Tippflächen mind. 44 px (claude.md Abschnitt 9) */
  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    transition: color 0.15s ease;
  }

  /* Social-Links mit Icon */
  .footer__links--social a { gap: 0.6rem; }
  .footer__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .footer__links--social a:hover .footer__icon {
    background: var(--color-green-500);
    border-color: var(--color-green-500);
  }

  /* Pflichtzeile */
  .footer__legal {
    background: rgba(0, 0, 0, 0.22);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer__legal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .footer__copy {
    font-size: var(--fs-small);
    margin: 0;
  }
  .footer__copy p {
    margin: 0;
  }
  .footer__credit {
    color: rgba(255, 255, 255, 0.6);
    margin-top: 2px !important;
  }
  .footer__credit a {
    color: rgba(255, 255, 255, 0.75);
  }
  .footer__credit a:hover {
    color: #fff;
  }
  .footer__legal-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-3);
  }
  .footer__legal-links a {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .footer__legal-links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  @media (min-width: 640px) {
    /* Tablet: Marke oben voll, darunter die drei Link-Spalten nebeneinander */
    .footer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-6) var(--space-5);
    }
  }
  @media (min-width: 960px) {
    /* Desktop: alles in einer Reihe (Marke + drei Spalten) */
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
      gap: var(--space-5);
    }
    .footer__brand {
      grid-column: auto;
    }
  }
</style>
