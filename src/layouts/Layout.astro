---
import "../styles/global.css";

// Schriften selbst gehostet (@fontsource): keine Google-Server, kein
// render-blockierendes externes CSS, DSGVO-sauber. Nur genutzte Gewichte.
import "@fontsource/oswald/500.css";
import "@fontsource/oswald/600.css";
import "@fontsource/oswald/700.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/400-italic.css";
import "@fontsource/source-sans-3/600.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "FC Lübbecke – Unser Verein. Unser Lübbecke.",
  description = "Der FC Lübbecke: ein Verein, vier Sparten – Fußball, Badminton, Darts und Laufsport. Komm vorbei und werde Mitglied.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

  </head>
  <body>
    <slot />
  </body>
</html>
