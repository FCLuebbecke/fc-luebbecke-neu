---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "FC Lübbecke – Unser Verein. Unser Lübbecke.",
  description = "Der FC Lübbecke: ein Verein, vier Sparten – Fußball, Badminton, Darts und Laufsport. Komm vorbei und werde Mitglied.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Oswald (Überschriften) + Source Sans 3 (Fließtext) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Flaticon UIcons (Bold Rounded) – Sparten-Icons. Version gepinnt für Stabilität.
         Lizenzhinweis/Attribution steht im Footer (Free-Tier-Pflicht). -->
    <link rel="preconnect" href="https://cdn-uicons.flaticon.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/2.6.0/uicons-bold-rounded/css/uicons-bold-rounded.css"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
