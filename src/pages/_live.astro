---
/**
 * FCL LIVE – Livestream & Pay-per-View-Mediathek.
 * Nachbau des WordPress-Plugins "FC Lübbecke LIVE" 3.0.73 als Astro-Seite.
 *
 * Die Seite ist eine statische Hülle: Videos, Preise und Spielplan lädt sie
 * zur Laufzeit von /api/live/data (Vercel-Function) – so erscheinen neue
 * Videos ohne neuen Build. PayPal & Cloudflare laden erst nach Klick (DSGVO).
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// ⚠️ TEMPORÄR: Mediathek & „Meine Käufe“ sind vorerst ausgeblendet – die Seite
// zeigt nur Livestream + Spiele. Zum Wiedereinschalten auf `true` setzen.
const MEDIATHEK_AKTIV = false;
---

<Layout
  title={MEDIATHEK_AKTIV
    ? "FCL LIVE – Livestream & Mediathek – FC Lübbecke"
    : "FCL LIVE – Livestream – FC Lübbecke"}
  description={MEDIATHEK_AKTIV
    ? "Spiele des FC Lübbecke live und in der Mediathek ansehen: komplette Spiele, Highlights und Tore – sicher bezahlen mit PayPal, sofort ansehen, den Verein unterstützen."
    : "Spiele des FC Lübbecke im Livestream ansehen – sicher bezahlen mit PayPal, sofort ansehen, den Verein unterstützen."}
>
  <Header />

  <main id="inhalt">
    <!-- ── Bühne ── -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="hero__kicker">FC Lübbecke</p>
          <h1 class="hero__title">FCL <span>LIVE</span></h1>
          <p class="hero__claim">
            {MEDIATHEK_AKTIV
              ? "Unsere Spiele im Livestream und in der Mediathek – komplette Spiele, Highlights und Tore. Jeder Kauf unterstützt direkt die Vereinsarbeit des FC Lübbecke."
              : "Unsere Spiele im Livestream – live dabei sein, wo immer du bist. Jeder Kauf unterstützt direkt die Vereinsarbeit des FC Lübbecke."}
          </p>
          <nav class="hero__nav" aria-label="LIVE-Bereiche">
            <a href="#livestream">Nächste Spiele</a>
            {MEDIATHEK_AKTIV && <a href="#mediathek">Mediathek</a>}
            {MEDIATHEK_AKTIV && <a href="#meine-kaeufe">Meine Käufe</a>}
          </nav>
        </div>

        <ul class="hero__benefits">
          <li>
            <span class="hero__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
            </span>
            <span>
              <strong>Sofort ansehen</strong>
              Nach dem Kauf startet dein Video direkt im Browser.
            </span>
          </li>
          <li>
            <span class="hero__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            </span>
            <span>
              <strong>Sicher bezahlen</strong>
              Zahlung über PayPal – auch mit Kredit- oder Debitkarte.
            </span>
          </li>
          <li>
            <span class="hero__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 20.5s-7.5-4.6-9.5-9C1.2 8.6 3 5.5 6.2 5.5c2 0 3.3 1 4 2.1.3.5 1.3.5 1.6 0 .7-1.1 2-2.1 4-2.1 3.2 0 5 3.1 3.7 6-2 4.4-9.5 9-9.5 9Z"/></svg>
            </span>
            <span>
              <strong>Verein unterstützen</strong>
              Die Einnahmen fließen zu 100&nbsp;% in den FC Lübbecke.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Hinweis, falls die LIVE-API (noch) nicht erreichbar/konfiguriert ist -->
    <div class="container">
      <p id="fcl-offline" class="offline" hidden>
        FCL LIVE ist gerade nicht erreichbar. Bitte versuche es später noch
        einmal.
      </p>
    </div>

    <!-- ── Nächste Spiele + Livestream ── -->
    <section id="livestream" class="container section">
      <h2 class="section-title">Nächste Spiele</h2>
      <p class="quelle">1. Mannschaft · live von FUSSBALL.DE</p>

      <div id="fcl-featured" class="featured" hidden>
        <div class="featured__match">
          <p class="featured__comp" data-slot="wettbewerb"></p>
          <div class="featured__teams">
            <span class="featured__team">
              <img class="featured__logo" data-slot="heim-logo" alt="" width="48" height="48" hidden />
              <span data-slot="heim"></span>
            </span>
            <span class="featured__vs">–</span>
            <span class="featured__team">
              <img class="featured__logo" data-slot="gast-logo" alt="" width="48" height="48" hidden />
              <span data-slot="gast"></span>
            </span>
          </div>
          <p class="featured__meta">
            <span data-slot="datum"></span> · Anstoß <span data-slot="zeit"></span> Uhr
          </p>
        </div>
        <div class="featured__action">
          <span class="featured__live-tag">LIVE</span>
          <button class="btn btn--primary" type="button" data-action="buy-live">
            Livestream freischalten
          </button>
          <button class="btn btn--secondary" type="button" data-action="watch-live" hidden>
            Livestream ansehen
          </button>
          <p class="featured__price" data-slot="live-preis"></p>
        </div>
      </div>

      <ul id="fcl-spiele" class="spiele"></ul>
      <p id="fcl-spiele-leer" class="leer" hidden>
        Zurzeit sind keine kommenden Spiele eingetragen.
      </p>

      <p class="datenschutz">
        Hinweis: Beim Kauf werden PayPal (Zahlung) und Cloudflare (Video)
        eingebunden – erst nach deinem Klick. Details in der
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </section>

    <!-- ── Mediathek (temporär ausgeblendet, siehe MEDIATHEK_AKTIV) ── -->
    {MEDIATHEK_AKTIV && (
      <section id="mediathek" class="mediathek">
        <div class="container section">
          <h2 class="section-title">Mediathek</h2>
          <p class="quelle">
            Komplette Spiele, Highlights und Tore – einzeln kaufen und sofort
            ansehen.
          </p>
          <div id="fcl-mediathek"></div>
          <p id="fcl-mediathek-leer" class="leer" hidden>
            Die Mediathek wird gerade gefüllt – schau bald wieder vorbei!
          </p>
        </div>
      </section>
    )}

    <!-- ── Meine Käufe (temporär ausgeblendet, siehe MEDIATHEK_AKTIV) ── -->
    {MEDIATHEK_AKTIV && (
      <section id="meine-kaeufe" class="container section">
        <h2 class="section-title">Meine Käufe</h2>
        <p class="quelle">
          Deine Käufe werden in diesem Browser gespeichert – ganz ohne Konto.
        </p>

        <ul id="fcl-kaeufe" class="kaeufe"></ul>
        <p id="fcl-kaeufe-leer" class="leer">
          Noch keine Käufe auf diesem Gerät.
        </p>

        <details class="restore">
          <summary>Früheren Kauf wiederherstellen</summary>
          <p>
            Gib deinen Wiederherstellungscode (<code>FCL-XXXXXXXX</code>) oder
            deine PayPal-Order-ID ein, um ein gekauftes Video auf diesem Gerät
            zu öffnen.
          </p>
          <form id="fcl-restore-form">
            <label class="sr-only" for="fcl-restore-code">Wiederherstellungscode</label>
            <input
              id="fcl-restore-code"
              name="code"
              type="text"
              placeholder="FCL-XXXXXXXX"
              autocomplete="off"
              required
            />
            <button class="btn btn--primary" type="submit">Wiederherstellen</button>
          </form>
          <p id="fcl-restore-status" role="status"></p>
        </details>
      </section>
    )}
  </main>

  <Footer />

  <!-- ── Kauf-Dialog (PayPal lädt erst hier – 2-Klick-Lösung) ── -->
  <dialog id="fcl-checkout" class="modal">
    <div class="modal__head">
      <h3 id="fcl-checkout-titel">Kauf abschließen</h3>
      <button class="modal__close" type="button" data-action="close-checkout" aria-label="Schließen">×</button>
    </div>
    <p id="fcl-checkout-info"></p>
    <div id="fcl-paypal-buttons"></div>
    <p id="fcl-checkout-status" role="status"></p>
    <p class="modal__hinweis">
      Mit dem Fortfahren werden Inhalte von PayPal geladen (Datenübertragung
      in die USA möglich). <a href="/datenschutz">Mehr erfahren</a>
    </p>
  </dialog>

  <!-- ── Wiederherstellungscode nach dem Kauf ── -->
  <dialog id="fcl-recovery" class="modal">
    <div class="modal__head">
      <h3>Danke für deinen Kauf! 💚</h3>
      <button class="modal__close" type="button" data-action="close-recovery" aria-label="Schließen">×</button>
    </div>
    <p>
      Das ist dein <strong>Wiederherstellungscode</strong>. Bitte notiere ihn –
      mit ihm kannst du dein Video auf jedem anderen Gerät wieder öffnen:
    </p>
    <p class="code" id="fcl-recovery-code"></p>
    <div class="modal__actions">
      <button class="btn btn--secondary" type="button" data-action="copy-code">Code kopieren</button>
      <button class="btn btn--primary" type="button" data-action="watch-bought">Video jetzt ansehen</button>
    </div>
  </dialog>

  <!-- ── Player ── -->
  <dialog id="fcl-player" class="modal modal--player">
    <div class="modal__head">
      <h3 id="fcl-player-titel">Video</h3>
      <button class="modal__close" type="button" data-action="close-player" aria-label="Schließen">×</button>
    </div>
    <div class="player" id="fcl-player-frame"></div>
  </dialog>
</Layout>

<script>
  /* FCL LIVE – Frontend-Logik (Käufe, Player, Wiederherstellung). */

  const API = "/api/live";

  type Video = {
    id: string;
    titel: string;
    kategorie: "spiel" | "highlights" | "tore";
    datum: string | null;
    gegner: string | null;
    beschreibung: string | null;
    preis: number;
    kostenlos: boolean;
    thumb: string | null;
  };
  type Spiel = {
    datum: string;
    zeit: string;
    heim: string;
    gast: string;
    heimLogo: string | null;
    gastLogo: string | null;
    wettbewerb: string;
  };
  type LiveConfig = {
    paypalClientId: string;
    livePreis: number;
    livestreamAktiv: boolean;
    liveKostenlos: boolean;
    bereit: boolean;
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    document.querySelector(sel) as T | null;

  const euro = (n: number) =>
    n.toLocaleString("de-DE", { style: "currency", currency: "EUR" });

  // ---- Gerätekennung & gespeicherte Zugänge (localStorage) ----
  function deviceId(): string {
    let id = localStorage.getItem("fcl_device_id");
    if (!id) {
      id = crypto.randomUUID();
      localStorage.setItem("fcl_device_id", id);
    }
    return id;
  }
  const keyFor = (videoId: string) => localStorage.getItem(`fcl_video_${videoId}`);
  const saveKey = (videoId: string, key: string) =>
    localStorage.setItem(`fcl_video_${videoId}`, key);
  const liveKey = () => localStorage.getItem("fcl_live_access");
  const saveLiveKey = (key: string) => localStorage.setItem("fcl_live_access", key);

  let config: LiveConfig | null = null;
  let videos: Video[] = [];
  let paypalPromise: Promise<any> | null = null;
  let checkoutContext: { art: "video" | "live"; video?: Video } | null = null;
  let zuletztGekauft: Video | null = null;

  // ---- Daten laden & rendern ----
  async function laden() {
    let data: { config: LiveConfig; videos: Video[]; spiele: Spiel[] };
    try {
      const res = await fetch(`${API}/data`);
      if (!res.ok) throw new Error(String(res.status));
      data = await res.json();
    } catch {
      $("#fcl-offline")?.removeAttribute("hidden");
      const kaeufeLeer = $("#fcl-kaeufe-leer");
      if (kaeufeLeer) kaeufeLeer.textContent = "Käufe können gerade nicht geladen werden.";
      return;
    }

    config = data.config;
    videos = data.videos;

    renderSpiele(data.spiele);
    renderMediathek();
    await geraetKaeufeLaden();
    renderKaeufe();
  }

  function renderSpiele(spiele: Spiel[]) {
    const featured = $("#fcl-featured");
    const liste = $("#fcl-spiele");
    if (!featured || !liste) return;

    if (!spiele.length) {
      $("#fcl-spiele-leer")?.removeAttribute("hidden");
    } else {
      const [erstes, ...rest] = spiele;
      featured.hidden = false;
      featured.querySelector('[data-slot="wettbewerb"]')!.textContent = erstes.wettbewerb;
      featured.querySelector('[data-slot="heim"]')!.textContent = erstes.heim;
      featured.querySelector('[data-slot="gast"]')!.textContent = erstes.gast;
      featured.querySelector('[data-slot="datum"]')!.textContent = erstes.datum;
      featured.querySelector('[data-slot="zeit"]')!.textContent = erstes.zeit;
      setLogo(featured.querySelector('[data-slot="heim-logo"]'), erstes.heimLogo, erstes.heim);
      setLogo(featured.querySelector('[data-slot="gast-logo"]'), erstes.gastLogo, erstes.gast);

      liste.innerHTML = "";
      for (const s of rest.slice(0, 5)) {
        const li = document.createElement("li");
        li.innerHTML = `
          <span class="spiele__datum">${s.datum} · ${s.zeit} Uhr</span>
          <span class="spiele__paarung">
            <img class="spiele__logo" alt="" width="26" height="26" loading="lazy" hidden />
            <span class="spiele__heim"></span>
            <span class="spiele__vs">–</span>
            <img class="spiele__logo" alt="" width="26" height="26" loading="lazy" hidden />
            <span class="spiele__gast"></span>
          </span>
          <span class="spiele__tag">${s.wettbewerb}</span>`;
        li.querySelector(".spiele__heim")!.textContent = s.heim;
        li.querySelector(".spiele__gast")!.textContent = s.gast;
        const logos = li.querySelectorAll<HTMLImageElement>(".spiele__logo");
        setLogo(logos[0], s.heimLogo, s.heim);
        setLogo(logos[1], s.gastLogo, s.gast);
        liste.appendChild(li);
      }
    }
    aktualisiereLiveButtons();
  }

  /** Vereinswappen setzen; ohne Logo bleibt das img versteckt. */
  function setLogo(img: Element | null, url: string | null, verein: string) {
    if (!(img instanceof HTMLImageElement)) return;
    if (!url) {
      img.hidden = true;
      return;
    }
    img.src = url;
    img.alt = `Wappen ${verein}`;
    img.hidden = false;
    img.addEventListener("error", () => (img.hidden = true), { once: true });
  }

  function aktualisiereLiveButtons() {
    const buy = $("#fcl-featured [data-action='buy-live']") as HTMLButtonElement | null;
    const watch = $("#fcl-featured [data-action='watch-live']") as HTMLButtonElement | null;
    const preis = $('#fcl-featured [data-slot="live-preis"]');
    if (!buy || !watch || !preis || !config) return;

    if (!config.livestreamAktiv) {
      buy.hidden = true;
      watch.hidden = true;
      preis.textContent = "Für dieses Spiel ist kein Livestream geplant.";
      return;
    }
    const hatZugang = config.liveKostenlos || Boolean(liveKey());
    buy.hidden = hatZugang;
    watch.hidden = !hatZugang;
    preis.textContent = config.liveKostenlos
      ? "Der Livestream ist heute kostenlos."
      : `${euro(config.livePreis)} · sicher bezahlen mit PayPal`;
  }

  function videoKarte(v: Video): HTMLElement {
    const gekauft = v.kostenlos || Boolean(keyFor(v.id));
    const karte = document.createElement("article");
    karte.className = "video";
    karte.innerHTML = `
      <div class="video__thumb">
        ${v.thumb ? `<img src="${v.thumb}" alt="" loading="lazy" />` : `<span class="video__thumb-fallback" aria-hidden="true">⚽</span>`}
        ${gekauft && !v.kostenlos ? '<span class="video__badge">Gekauft ✓</span>' : ""}
        ${v.kostenlos ? '<span class="video__badge">Kostenlos</span>' : ""}
      </div>
      <div class="video__body">
        <h4 class="video__titel"></h4>
        <p class="video__meta"></p>
        <div class="video__foot">
          <span class="video__preis">${v.kostenlos ? "Kostenlos" : euro(v.preis)}</span>
          <button class="btn ${gekauft ? "btn--secondary" : "btn--primary"} video__btn" type="button">
            ${gekauft ? "Ansehen" : "Kaufen"}
          </button>
        </div>
      </div>`;
    karte.querySelector(".video__titel")!.textContent = v.titel;
    karte.querySelector(".video__meta")!.textContent = [
      v.datum ? new Date(v.datum).toLocaleDateString("de-DE") : null,
      v.gegner ? `gegen ${v.gegner}` : null,
    ]
      .filter(Boolean)
      .join(" · ");
    karte
      .querySelector(".video__btn")!
      .addEventListener("click", () => (gekauft ? abspielen(v) : kaufen(v)));
    return karte;
  }

  /**
   * Mediathek wie im Plugin: ein aufklappbarer Block pro SPIEL (Gegner+Datum),
   * darin die Kategorien „Komplettes Spiel“, „Highlights“, „Tore“.
   * Videos ohne Gegner landen gesammelt unter „Weitere Videos“.
   */
  function renderMediathek() {
    const wrap = $("#fcl-mediathek");
    if (!wrap) return;
    wrap.innerHTML = "";
    if (!videos.length) {
      $("#fcl-mediathek-leer")?.removeAttribute("hidden");
      return;
    }
    $("#fcl-mediathek-leer")?.setAttribute("hidden", "");

    // Nach Spiel gruppieren – Reihenfolge folgt der Sortierung der API
    // (Reihenfolge-Feld, dann neuestes Datum zuerst).
    const gruppen = new Map<string, Video[]>();
    for (const v of videos) {
      const key = v.gegner ? `${v.datum ?? ""}|${v.gegner}` : "_sonstige";
      if (!gruppen.has(key)) gruppen.set(key, []);
      gruppen.get(key)!.push(v);
    }

    const KATEGORIE_LABEL: Record<Video["kategorie"], string> = {
      spiel: "Komplettes Spiel",
      highlights: "Highlights",
      tore: "Tore",
    };

    let erste = true;
    for (const [key, gruppe] of gruppen) {
      const ref = gruppe[0];
      const details = document.createElement("details");
      details.className = "match";
      if (erste) details.open = true;
      erste = false;

      const summary = document.createElement("summary");
      summary.className = "match__kopf";
      const thumb = gruppe.find((v) => v.thumb)?.thumb;
      summary.innerHTML = `
        <span class="match__thumb">${thumb ? `<img src="${thumb}" alt="" loading="lazy" />` : `<span aria-hidden="true">⚽</span>`}</span>
        <span class="match__info">
          <span class="match__titel"></span>
          <span class="match__meta"></span>
        </span>
        <span class="match__anzahl">${gruppe.length} ${gruppe.length === 1 ? "Video" : "Videos"}</span>
        <svg class="match__chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>`;
      summary.querySelector(".match__titel")!.textContent =
        key === "_sonstige" ? "Weitere Videos" : `FC Lübbecke – ${ref.gegner}`;
      summary.querySelector(".match__meta")!.textContent =
        key === "_sonstige"
          ? "Clips und Zusammenschnitte"
          : ref.datum
            ? new Date(ref.datum).toLocaleDateString("de-DE", { day: "2-digit", month: "2-digit", year: "numeric" })
            : "";
      details.appendChild(summary);

      const inhalt = document.createElement("div");
      inhalt.className = "match__inhalt";
      for (const kat of ["spiel", "highlights", "tore"] as const) {
        const katVideos = gruppe.filter((v) => v.kategorie === kat);
        if (!katVideos.length) continue;
        const h = document.createElement("h4");
        h.className = "match__kategorie";
        h.textContent = KATEGORIE_LABEL[kat];
        const grid = document.createElement("div");
        grid.className = "mediathek__grid";
        katVideos.forEach((v) => grid.appendChild(videoKarte(v)));
        inhalt.append(h, grid);
      }
      details.appendChild(inhalt);
      wrap.appendChild(details);
    }
  }

  async function geraetKaeufeLaden() {
    try {
      const res = await fetch(`${API}/purchases?deviceId=${encodeURIComponent(deviceId())}`);
      if (!res.ok) return;
      const { items } = (await res.json()) as {
        items: { videoId: string; accessKey: string }[];
      };
      items.forEach((k) => saveKey(k.videoId, k.accessKey));
    } catch {
      /* Käufe bleiben dann lokal */
    }
  }

  function renderKaeufe() {
    const liste = $("#fcl-kaeufe");
    const leer = $("#fcl-kaeufe-leer");
    if (!liste || !leer) return;
    liste.innerHTML = "";

    const gekauft = videos.filter((v) => !v.kostenlos && keyFor(v.id));
    leer.hidden = gekauft.length > 0;

    for (const v of gekauft) {
      const li = document.createElement("li");
      li.innerHTML = `
        <span class="kaeufe__titel"></span>
        <span class="kaeufe__status">Gekauft ✓</span>
        <button class="btn btn--secondary" type="button">Ansehen</button>`;
      li.querySelector(".kaeufe__titel")!.textContent = v.titel;
      li.querySelector("button")!.addEventListener("click", () => abspielen(v));
      liste.appendChild(li);
    }
  }

  // ---- Abspielen ----
  async function abspielen(v: Video) {
    const params = new URLSearchParams({ videoId: v.id });
    const key = keyFor(v.id);
    if (key) params.set("accessKey", key);
    await oeffnePlayer(`${API}/video-stream?${params}`, v.titel);
  }

  async function liveAbspielen() {
    const params = new URLSearchParams();
    const key = liveKey();
    if (key) params.set("accessKey", key);
    await oeffnePlayer(`${API}/live-stream?${params}`, "Livestream");
  }

  async function oeffnePlayer(url: string, titel: string) {
    try {
      const res = await fetch(url);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? "Fehler");
      $("#fcl-player-titel")!.textContent = titel;
      $("#fcl-player-frame")!.innerHTML =
        `<iframe src="${data.iframeUrl}" allow="accelerometer; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
      ($("#fcl-player") as HTMLDialogElement).showModal();
    } catch (err) {
      alert(err instanceof Error ? err.message : "Das Video kann gerade nicht geladen werden.");
    }
  }

  // ---- Kaufen (PayPal – lädt erst nach Klick) ----
  function ladePayPal(): Promise<any> {
    if (!paypalPromise) {
      paypalPromise = new Promise((resolve, reject) => {
        const s = document.createElement("script");
        s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(config!.paypalClientId)}&currency=EUR&intent=capture&components=buttons&locale=de_DE`;
        s.onload = () => resolve((window as any).paypal);
        s.onerror = () => reject(new Error("PayPal konnte nicht geladen werden."));
        document.head.appendChild(s);
      });
    }
    return paypalPromise;
  }

  async function kaufen(v: Video) {
    checkoutContext = { art: "video", video: v };
    $("#fcl-checkout-titel")!.textContent = v.titel;
    $("#fcl-checkout-info")!.textContent =
      `Einmalig ${euro(v.preis)} – danach kannst du das Video sofort ansehen.`;
    await starteCheckout();
  }

  async function liveKaufen() {
    if (config?.liveKostenlos) {
      await liveAbspielen();
      return;
    }
    checkoutContext = { art: "live" };
    $("#fcl-checkout-titel")!.textContent = "Livestream freischalten";
    $("#fcl-checkout-info")!.textContent =
      `Einmalig ${euro(config!.livePreis)} – der Zugang gilt 6 Stunden ab Kauf.`;
    await starteCheckout();
  }

  async function starteCheckout() {
    const dialog = $("#fcl-checkout") as HTMLDialogElement;
    const status = $("#fcl-checkout-status")!;
    const container = $("#fcl-paypal-buttons")!;
    container.innerHTML = "";
    status.textContent = "PayPal wird geladen …";
    dialog.showModal();

    if (!config?.bereit || !config.paypalClientId) {
      status.textContent =
        "Der Kauf ist noch nicht freigeschaltet (Konfiguration fehlt).";
      return;
    }

    try {
      const paypal = await ladePayPal();
      status.textContent = "";
      paypal
        .Buttons({
          createOrder: async () => {
            const ctx = checkoutContext!;
            const url = ctx.art === "live" ? `${API}/live-create` : `${API}/video-create`;
            const res = await fetch(url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(ctx.art === "video" ? { videoId: ctx.video!.id } : {}),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error ?? "Fehler beim Anlegen der Bestellung.");
            return data.orderId;
          },
          onApprove: async (approveData: { orderID: string }) => {
            status.textContent = "Zahlung wird bestätigt …";
            const ctx = checkoutContext!;
            const url = ctx.art === "live" ? `${API}/live-capture` : `${API}/video-capture`;
            const res = await fetch(url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                orderId: approveData.orderID,
                deviceId: deviceId(),
                ...(ctx.art === "video" ? { videoId: ctx.video!.id } : {}),
              }),
            });
            const data = await res.json();
            if (!res.ok) {
              status.textContent = data.error ?? "Die Zahlung konnte nicht bestätigt werden.";
              return;
            }
            dialog.close();
            if (ctx.art === "live") {
              saveLiveKey(data.accessKey);
              aktualisiereLiveButtons();
              await liveAbspielen();
            } else {
              saveKey(ctx.video!.id, data.accessKey);
              zuletztGekauft = ctx.video!;
              renderMediathek();
              renderKaeufe();
              if (data.recoveryCode) {
                localStorage.setItem(`fcl_recovery_${ctx.video!.id}`, data.recoveryCode);
                $("#fcl-recovery-code")!.textContent = data.recoveryCode;
                ($("#fcl-recovery") as HTMLDialogElement).showModal();
              } else {
                await abspielen(ctx.video!);
              }
            }
          },
          onError: () => {
            status.textContent = "Bei der Zahlung ist ein Fehler aufgetreten. Bitte versuche es erneut.";
          },
        })
        .render(container);
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : "PayPal konnte nicht geladen werden.";
    }
  }

  // ---- Wiederherstellung ----
  async function wiederherstellen(code: string) {
    const status = $("#fcl-restore-status")!;
    status.textContent = "Wird geprüft …";
    try {
      const res = await fetch(`${API}/restore`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code, deviceId: deviceId() }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? "Wiederherstellung fehlgeschlagen.");
      saveKey(data.videoId, data.accessKey);
      renderMediathek();
      renderKaeufe();
      status.textContent = `„${data.titel ?? "Video"}“ wurde freigeschaltet. Viel Spaß!`;
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : "Wiederherstellung fehlgeschlagen.";
    }
  }

  // ---- Events ----
  document.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest("[data-action]");
    if (!el) return;
    switch (el.getAttribute("data-action")) {
      case "buy-live":
        void liveKaufen();
        break;
      case "watch-live":
        void liveAbspielen();
        break;
      case "close-checkout":
        ($("#fcl-checkout") as HTMLDialogElement).close();
        break;
      case "close-recovery":
        ($("#fcl-recovery") as HTMLDialogElement).close();
        break;
      case "copy-code": {
        const code = $("#fcl-recovery-code")?.textContent ?? "";
        void navigator.clipboard?.writeText(code);
        (el as HTMLButtonElement).textContent = "Kopiert ✓";
        break;
      }
      case "watch-bought":
        ($("#fcl-recovery") as HTMLDialogElement).close();
        if (zuletztGekauft) void abspielen(zuletztGekauft);
        break;
      case "close-player":
        $("#fcl-player-frame")!.innerHTML = "";
        ($("#fcl-player") as HTMLDialogElement).close();
        break;
    }
  });

  // Beim Schließen des Players das Video wirklich stoppen (iframe entfernen).
  $("#fcl-player")?.addEventListener("close", () => {
    $("#fcl-player-frame")!.innerHTML = "";
  });

  $("#fcl-restore-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = $("#fcl-restore-code") as HTMLInputElement;
    if (input.value.trim()) void wiederherstellen(input.value.trim());
  });

  void laden();
</script>

