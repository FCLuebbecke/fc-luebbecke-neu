---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import SparteKontakt from "../../components/SparteKontakt.astro";
import Footer from "../../components/Footer.astro";
import { badminton } from "../../data/sparten";
---
<Layout title="Kontakt – Badminton – FC Lübbecke" description="Ansprechpartner und Schnuppertraining der Badminton-Sparte des FC Lübbecke.">
  <Header active="badminton" />
  <SparteHeader {...badminton} active="kontakt" />
  <SparteKontakt data={badminton} />
  <Footer />
</Layout>
