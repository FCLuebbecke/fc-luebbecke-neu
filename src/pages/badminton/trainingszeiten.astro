---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import SparteTrainingszeiten from "../../components/SparteTrainingszeiten.astro";
import Footer from "../../components/Footer.astro";
import { badminton } from "../../data/sparten";
import { getSparteInfo } from "../../lib/sanity";

// Trainingszeiten + Ort aus Sanity; je Feld Fallback auf data/sparten.ts,
// falls (noch) nichts gepflegt ist.
const info = await getSparteInfo("badminton");
const data = {
  ...badminton,
  training: info?.training?.length ? info.training : badminton.training,
  ortName: info?.ortName || badminton.ortName,
  ortAdresse: info?.ortAdresse || badminton.ortAdresse,
};
---
<Layout title="Badminton – Trainingszeiten – FC Lübbecke" description="Trainingszeiten und Halle der Badminton-Sparte des FC Lübbecke.">
  <Header active="badminton" />
  <SparteHeader {...badminton} active="trainingszeiten" />
  <SparteTrainingszeiten data={data} />
  <Footer />
</Layout>
