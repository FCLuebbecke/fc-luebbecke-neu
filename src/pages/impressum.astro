 * Impressum – Inhalte 1:1 von der bisherigen Vereinsseite übernommen
 * (https://www.fclübbecke.de/impressum/), Stand: 2026-08-10.
 * Der Footer verlinkt dauerhaft hierher (claude.md Abschnitt 10).
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
