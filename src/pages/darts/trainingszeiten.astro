---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import SparteTrainingszeiten from "../../components/SparteTrainingszeiten.astro";
import Footer from "../../components/Footer.astro";
import { darts } from "../../data/sparten";
import { getSparteInfo } from "../../lib/sanity";

// Trainingszeiten + Ort aus Sanity (Typ dartsInfo); Fallback je Feld auf data/sparten.ts.
const info = await getSparteInfo("darts");
const data = {
  ...darts,
  training: info?.training?.length ? info.training : darts.training,
  ortName: info?.ortName || darts.ortName,
  ortAdresse: info?.ortAdresse || darts.ortAdresse,
};
---
<Layout title="Darts – Trainingszeiten – FC Lübbecke" description="Trainingszeiten und Treffpunkt der Darts-Sparte des FC Lübbecke.">
  <Header active="darts" />
  <SparteHeader {...darts} active="trainingszeiten" />
  <SparteTrainingszeiten data={data} />
  <Footer />
</Layout>
