---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import SparteKontakt from "../../components/SparteKontakt.astro";
import Footer from "../../components/Footer.astro";
import { darts } from "../../data/sparten";
---
<Layout title="Darts – Kontakt – FC Lübbecke" description="Ansprechpartner und Mitmach-Einladung der Darts-Sparte des FC Lübbecke.">
  <Header active="darts" />
  <SparteHeader {...darts} active="kontakt" />
  <SparteKontakt data={darts} />
  <Footer />
</Layout>
