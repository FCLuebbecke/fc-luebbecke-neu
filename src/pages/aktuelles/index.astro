---
/**
 * /aktuelles – gemeinsamer Strom aus Beiträgen und Instagram (Spec 007).
 * Beiträge als große Karten, Instagram-Posts als kleinere Kacheln mit ↗,
 * chronologisch. Filter nach Sparte (ohne JavaScript: alles sichtbar).
 */
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BeitragKarte from "../../components/BeitragKarte.astro";
import { getBeitraege, datumKurz, type Beitrag } from "../../lib/inhalte";
import { getInstagramPosts, type InstagramPost } from "../../lib/instagram";

const GRENZE = 60;
const TAGE_INSTAGRAM = 90;

const beitraege = await getBeitraege();
const seit = Date.now() - TAGE_INSTAGRAM * 24 * 60 * 60 * 1000;
const posts = (await getInstagramPosts(12)).filter((p) => new Date(p.timestamp).getTime() >= seit);

type Eintrag =
  | { art: "beitrag"; datum: string; b: Beitrag }
  | { art: "instagram"; datum: string; p: InstagramPost };

const alle: Eintrag[] = [
  ...beitraege.map((b) => ({ art: "beitrag" as const, datum: b.datum, b })),
  ...posts.map((p) => ({ art: "instagram" as const, datum: p.timestamp.slice(0, 10), p })),
].sort((a, b) => b.datum.localeCompare(a.datum));
const eintraege = alle.slice(0, GRENZE);
const abgeschnitten = alle.length > GRENZE;

const filter = [
  { id: "alle", label: "Alle" },
  { id: "fussball", label: "Fußball" },
  { id: "badminton", label: "Badminton" },
  { id: "darts", label: "Darts" },
  { id: "verein", label: "Verein" },
  { id: "instagram", label: "Instagram" },
];

const igBild = (p: InstagramPost) => (p.mediaType === "VIDEO" ? p.thumbnailUrl : undefined) ?? p.mediaUrl;
const igText = (p: InstagramPost) => (p.prunedCaption ?? p.caption ?? "Instagram-Beitrag des FC Lübbecke").replace(/\s+/g, " ").trim();
---

<Layout
  title="Aktuelles – FC Lübbecke"
  description="Neuigkeiten aus dem FC Lübbecke: Spielberichte, Termine und Vereinsleben aus Fußball, Badminton und Darts – dazu die neuesten Instagram-Beiträge."
>
  <Header active="aktuelles" />
  <main id="inhalt" class="container aktuell">
    <h1 class="section-title">Aktuelles</h1>
    <p class="aktuell__intro">Berichte, Termine und Vereinsleben aus allen Sparten – und die neuesten Bilder von Instagram.</p>

    <div class="filter" role="group" aria-label="Nach Sparte filtern" hidden>
      {filter.map((f) => (
        <button type="button" class="filter__btn" data-filter={f.id} aria-pressed={f.id === "alle" ? "true" : "false"}>
          {f.label}
        </button>
      ))}
    </div>

    {eintraege.length === 0 ? (
      <p class="aktuell__leer">Noch keine Beiträge – schau bald wieder vorbei.</p>
    ) : (
      <ul class="strom">
        {eintraege.map((e) =>
          e.art === "beitrag" ? (
            <li class="strom__eintrag strom__eintrag--beitrag" data-sparte={e.b.sparte}>
              <BeitragKarte beitrag={e.b} />
            </li>
          ) : (
            <li class="strom__eintrag strom__eintrag--ig" data-sparte="instagram">
              <a class="ig-kachel" href={e.p.permalink} target="_blank" rel="noopener noreferrer">
                <Image src={igBild(e.p)} alt={igText(e.p).slice(0, 140)} width={480} height={480} fit="cover" format="webp" loading="lazy" />
                <span class="ig-kachel__body">
                  <span class="ig-kachel__meta">
                    <time datetime={e.datum}>{datumKurz(e.datum)}</time>
                    <span class="etikett etikett--instagram">
                      <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 4.8a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" /></svg>
                      Instagram
                    </span>
                  </span>
                  <span class="ig-kachel__text">{igText(e.p)}</span>
                  <span class="ig-kachel__link">Auf Instagram ansehen <span aria-hidden="true">↗</span><span class="sr-only"> (öffnet in neuem Fenster)</span></span>
                </span>
              </a>
            </li>
          ),
        )}
      </ul>
    )}
    <p class="aktuell__leer" data-leer hidden>Für diese Auswahl gibt es gerade keine Einträge.</p>
    {abgeschnitten && <p class="aktuell__hinweis">Es werden die {GRENZE} neuesten Einträge gezeigt.</p>}
  </main>
  <Footer />
</Layout>

<script>
  const leiste = document.querySelector<HTMLElement>(".filter");
  const knoepfe = [...document.querySelectorAll<HTMLButtonElement>(".filter__btn")];
  const eintraege = [...document.querySelectorAll<HTMLElement>(".strom__eintrag")];
  const leer = document.querySelector<HTMLElement>("[data-leer]");
  const gueltig = new Set(knoepfe.map((k) => k.dataset.filter));

  function anwenden(wahl: string) {
    let sichtbar = 0;
    for (const e of eintraege) {
      const zeigen = wahl === "alle" || e.dataset.sparte === wahl;
      e.hidden = !zeigen;
      if (zeigen) sichtbar++;
    }
    for (const k of knoepfe) k.setAttribute("aria-pressed", String(k.dataset.filter === wahl));
    if (leer) leer.hidden = sichtbar > 0 || eintraege.length === 0;
    const url = new URL(location.href);
    if (wahl === "alle") url.searchParams.delete("sparte");
    else url.searchParams.set("sparte", wahl);
    history.replaceState(null, "", url);
  }

  if (leiste && eintraege.length > 0) {
    leiste.hidden = false; // ohne JavaScript bleibt die Leiste verborgen, alles sichtbar
    for (const k of knoepfe) k.addEventListener("click", () => anwenden(k.dataset.filter ?? "alle"));
    const start = new URL(location.href).searchParams.get("sparte");
    if (start && gueltig.has(start)) anwenden(start);
  }
</script>

<style>
  .aktuell { padding-block: var(--space-5) var(--space-6); }
  .aktuell__intro { margin-top: var(--space-2); color: var(--color-muted); max-width: var(--measure); }
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
  }
  .filter[hidden] { display: none; }
  .filter__btn {
    min-height: var(--tap);
    padding: 0 var(--space-2);
    border: 2px solid var(--color-green-700);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-green-700);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .filter__btn[aria-pressed="true"] {
    background: var(--color-green-700);
    color: #fff;
  }
  .filter__btn:focus-visible { outline: 3px solid var(--color-green-500); outline-offset: 2px; }
  .strom {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }
  .strom__eintrag { min-width: 0; }
  .strom__eintrag--beitrag { grid-column: 1 / -1; }
  .strom__eintrag[hidden] { display: none; }
  .ig-kachel {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    color: var(--color-ink);
    text-decoration: none;
  }
  .ig-kachel :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .ig-kachel__body { display: flex; flex-direction: column; gap: 0.4rem; padding: var(--space-2); flex: 1; }
  .ig-kachel__meta { display: flex; align-items: center; gap: var(--space-1); color: var(--color-muted); font-size: var(--fs-small); }
  .ig-kachel__meta .etikett { display: inline-flex; align-items: center; gap: 0.3em; }
  .ig-kachel__text {
    font-size: var(--fs-small);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ig-kachel__link { margin-top: auto; color: var(--color-green-700); font-weight: 600; font-size: var(--fs-small); }
  .ig-kachel:hover .ig-kachel__link { text-decoration: underline; }
  .aktuell__leer, .aktuell__hinweis { margin-top: var(--space-4); color: var(--color-muted); }
  @media (min-width: 720px) {
    .strom { grid-template-columns: repeat(4, 1fr); }
    .strom__eintrag--beitrag { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .strom { grid-template-columns: repeat(6, 1fr); }
    .strom__eintrag--beitrag { grid-column: span 3; }
    .strom__eintrag--ig { grid-column: span 2; }
  }
</style>
