---
/**
 * Mitglied-werden-Seite (claude.md Abschnitt 6.6 – jetzt als eigene Seite).
 * Aufbau: grüner Header · Vorteile · "So wirst du Mitglied" (3 Schritte) ·
 * Satzung & Anträge (Service-Downloads) · Anmeldung · Fragen-CTA.
 * (Beiträge-Sektion entfernt – keine belegten Zahlen vorhanden.)
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { KONTAKT_MAIL, KONTAKT_MAILTO } from "../data/kontakt";

const vorteile = [
  {
    titel: "Vier Sparten, ein Beitrag",
    text: "Fußball, Badminton, Darts und Laufsport – als Mitglied steht dir der ganze Verein offen.",
  },
  {
    titel: "Unverbindlich schnuppern",
    text: "Komm jederzeit zum Probetraining. Erst reinschnuppern, dann entscheiden.",
  },
  {
    titel: "Für jedes Alter",
    text: "Von den Minis bis zu den Senioren – bei uns findet jeder sein Team.",
  },
  {
    titel: "Echtes Vereinsleben",
    text: "Feste, Turniere und Aktionen abseits des Platzes – Gemeinschaft, die trägt.",
  },
];

const schritte = [
  {
    nr: 1,
    titel: "Sparte aussuchen & melden",
    text: "Schreib uns kurz, welche Sportart dich interessiert. Wir sagen dir, wann und wo das passende Team trainiert.",
  },
  {
    nr: 2,
    titel: "Zum Probetraining kommen",
    text: "Schau unverbindlich vorbei, lern Trainer und Mannschaft kennen – ganz ohne Verpflichtung.",
  },
  {
    nr: 3,
    titel: "Mitgliederantrag ausfüllen",
    text: "Gefällt's dir, füllst du den Mitgliederantrag aus – online oder direkt vor Ort. Willkommen im FC Lübbecke!",
  },
];

// Satzung & Anträge (gleiche Quellen wie im Footer: PDFs in public/service/,
// Mitgliederantrag als Online-Formular beim DFBnet).
const service = [
  {
    label: "Vereinssatzung (PDF)",
    href: "/service/vereinssatzung.pdf",
    text: "Die Satzung des FC Lübbecke e.V. zum Nachlesen.",
  },
  {
    label: "Mitgliederantrag",
    href: "https://verein.dfbnet.org/mitgliedsantrag/fcluebbecke",
    text: "Online-Formular beim DFBnet – direkt ausfüllen und absenden.",
  },
  {
    label: "Passantrag (PDF)",
    href: "/service/passantrag.pdf",
    text: "WDFV-Formular, um dein Spielrecht zu beantragen.",
  },
  {
    label: "Stellv. Abmeldung (PDF)",
    href: "/service/stellvertretende-abmeldung.pdf",
    text: "Musterformular für die stellvertretende Abmeldung bei deinem bisherigen Verein.",
  },
];
---

<Layout
  title="Mitglied werden – FC Lübbecke"
  description="Werde Mitglied im FC Lübbecke e.V. – Fußball, Badminton, Darts und Laufsport. So einfach geht der Beitritt, mit Satzung, Mitglieder- und Passantrag zum Download."
>
  <Header active="mitglied" />

  <!-- Header / Bühne -->
  <section class="mw-hero" aria-labelledby="mw-title">
    <div class="container mw-hero__inner">
      <span class="mw-kicker">FC Lübbecke e.V. · seit 1925</span>
      <h1 id="mw-title">Mitglied werden</h1>
      <p class="mw-hero__claim">Ein Verein, vier Sparten – dein Platz ist frei.</p>
      <p class="mw-hero__lead">
        Ob auf dem Rasen, in der Halle, an der Scheibe oder auf der Laufstrecke:
        Beim FC Lübbecke ist jeder willkommen, der Sport und Gemeinschaft liebt.
        Komm vorbei, schnupper rein und werde Teil des Vereins.
      </p>
      <div class="mw-hero__actions">
        <a class="btn btn--light" href={`${KONTAKT_MAILTO}?subject=Mitglied%20werden`}>
          Jetzt anfragen
        </a>
        <a class="btn btn--ghost-light" href="#service">Satzung & Anträge</a>
      </div>
    </div>
  </section>

  <main id="inhalt">
    <!-- Vorteile -->
    <section class="container section">
      <h2 class="section-title">Darum FC Lübbecke</h2>
      <ul class="mw-vorteile">
        {vorteile.map((v) => (
          <li class="mw-vorteil">
            <span class="mw-vorteil__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="mw-vorteil__titel">{v.titel}</h3>
              <p class="mw-vorteil__text">{v.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- So wirst du Mitglied -->
    <section class="mw-steps-wrap">
      <div class="container section">
        <h2 class="section-title">So wirst du Mitglied</h2>
        <ol class="mw-steps">
          {schritte.map((s) => (
            <li class="mw-step">
              <span class="mw-step__nr" aria-hidden="true">{s.nr}</span>
              <h3 class="mw-step__titel">{s.titel}</h3>
              <p class="mw-step__text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Satzung & Anträge -->
    <section class="container section" id="service">
      <h2 class="section-title">Satzung & Anträge</h2>
      <p class="mw-intro">
        Alle Unterlagen für deinen Beitritt auf einen Blick – zum Ausfüllen
        oder Herunterladen.
      </p>
      <ul class="mw-service">
        {service.map((s) => (
          <li>
            <a class="mw-doc" href={s.href} target="_blank" rel="noopener noreferrer">
              <h3 class="mw-doc__label">
                {s.label}
                <span aria-hidden="true"> ↗</span>
                <span class="sr-only"> (öffnet in neuem Fenster)</span>
              </h3>
              <p class="mw-doc__text">{s.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Anmeldung -->
    <section class="mw-anmeldung-wrap">
      <div class="container section">
        <h2 class="section-title">Anmeldung</h2>
        <div class="mw-anmeldung">
          <div class="prose">
            <p>
              Am schnellsten geht's per E-Mail: Schreib uns, welche Sparte dich
              interessiert und ein paar Eckdaten (Name, Alter), dann melden wir
              uns mit allem Weiteren bei dir.
            </p>
            <p>
              Lieber persönlich? Komm einfach zu einem Probetraining vorbei –
              den Aufnahmeantrag gibt's auch direkt vor Ort.
            </p>
          </div>
          <a class="btn btn--primary" href={`${KONTAKT_MAILTO}?subject=Mitglied%20werden`}>
            Anfrage per E-Mail senden
          </a>
        </div>
      </div>
    </section>

    <!-- Fragen-CTA -->
    <section class="mw-cta">
      <div class="container mw-cta__inner">
        <div>
          <h2 class="mw-cta__title">Noch Fragen?</h2>
          <p class="mw-cta__text">
            Melde dich gern – wir helfen dir weiter und finden gemeinsam dein Team.
          </p>
        </div>
        <a class="btn btn--primary" href={KONTAKT_MAILTO}>
          {KONTAKT_MAIL}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Header / Bühne ── */
  .mw-hero {
    background: linear-gradient(135deg, var(--color-green-700) 0%, var(--color-green-900) 100%);
    color: #fff;
    padding-block: var(--space-6);
  }
  .mw-hero__inner { max-width: 60ch; }
  .mw-kicker {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .mw-hero h1 { color: #fff; margin-top: var(--space-2); }
  .mw-hero__claim {
    margin-top: var(--space-2);
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-h2);
    color: rgba(255, 255, 255, 0.95);
  }
  .mw-hero__lead {
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.88);
  }
  .mw-hero__actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .section { padding-block: var(--space-6); }
  .mw-intro { margin-top: var(--space-2); color: var(--color-muted); max-width: 60ch; }

  /* ── Vorteile ── */
  .mw-vorteile {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .mw-vorteil {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-green-050);
    border: 1px solid rgba(10, 80, 18, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  .mw-vorteil__check {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--color-green-700);
    color: #fff;
  }
  .mw-vorteil__titel { color: var(--color-green-900); }
  .mw-vorteil__text { margin-top: 0.25rem; color: var(--color-muted); }

  /* ── Schritte ── */
  .mw-steps-wrap { background: var(--color-green-050); }
  .mw-steps {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .mw-step {
    position: relative;
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
  }
  .mw-step__nr {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-green-700);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.3rem;
    margin-bottom: var(--space-2);
  }
  .mw-step__titel { color: var(--color-green-900); }
  .mw-step__text { margin-top: 0.4rem; color: var(--color-muted); }

  /* ── Satzung & Anträge ── */
  .mw-service {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .mw-doc {
    display: block;
    height: 100%;
    background: var(--color-white);
    border: 1px solid rgba(10, 80, 18, 0.12);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .mw-doc:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .mw-doc__label { color: var(--color-green-700); }
  .mw-doc__text {
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* ── Anmeldung ── */
  .mw-anmeldung-wrap { background: var(--color-green-050); }
  .mw-anmeldung {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .mw-anmeldung .btn { align-self: start; }

  /* ── CTA ── */
  .mw-cta { background: var(--color-white); padding-block: var(--space-6); }
  .mw-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    background: var(--color-green-050);
    border: 1px solid rgba(10, 80, 18, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }
  .mw-cta__title { color: var(--color-green-700); }
  .mw-cta__text { margin-top: var(--space-2); color: var(--color-ink); }

  /* Sticky-Header beim Ankersprung zu #service nicht überdecken */
  #service { scroll-margin-top: 88px; }

  @media (max-width: 520px) {
    .mw-hero__actions .btn { width: 100%; }
  }

  @media (min-width: 640px) {
    .mw-vorteile { grid-template-columns: repeat(2, 1fr); }
    .mw-steps { grid-template-columns: repeat(3, 1fr); }
    .mw-service { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .mw-anmeldung {
      grid-template-columns: 1.4fr 0.6fr;
      gap: var(--space-6);
      align-items: center;
    }
  }
</style>
