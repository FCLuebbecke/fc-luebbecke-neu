---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import Footer from "../../components/Footer.astro";
import TrainerListe from "../../components/TrainerListe.astro";
import SparteAktuelles from "../../components/SparteAktuelles.astro";
import { Image, getImage } from "astro:assets";
import { getMannschaften, type MannschaftDoc, type TrainerEintrag } from "../../lib/inhalte";

// Mannschaften aus src/content/mannschaften/, nach Kategorie aufgeteilt.
const docs = await getMannschaften();
const herren = docs.filter((d) => d.kategorie === "herren");
const jugend = docs.filter((d) => d.kategorie === "jugend");

// Die erste Mannschaft (per Reihenfolge sortiert) wird als breite Karte mit
// Foto hervorgehoben; alle weiteren Herren-Teams kompakt nur mit Daten.
const [ersteMannschaft, ...weitereHerren] = herren;

// Trainingseinheiten als Textzeilen („Zeit · Ort“).
function trainingZeilen(m: MannschaftDoc): string[] {
  return (m.training ?? []).map((t) => (t.ort ? `${t.zeit} · ${t.ort}` : t.zeit));
}

function trainerListe(m: MannschaftDoc): TrainerEintrag[] {
  return m.trainerteam ?? [];
}

// Großansicht (Dialog) der Herren-Fotos: vorab in 1600 px erzeugen.
const fotosGross = await Promise.all(
  weitereHerren.map((t) => (t.foto ? getImage({ src: t.foto.src, width: 1600 }).then((b) => b.src) : "")),
);
---

<Layout title="Mannschaften – Fußball – FC Lübbecke" description="Die Fußball-Mannschaften des FC Lübbecke: Herren (1. Mannschaft Landesliga, 2. Mannschaft, Alte Herren) und Jugend von den Bambinis bis zur A-Jugend.">
  <Header active="fussball" />
  <SparteHeader
    name="Fußball"
    claim="Die größte Sparte des FC Lübbecke – von der 1. Mannschaft bis zur Jugend."
    basePath="/fussball"
    tag="Größte Sparte"
    withSpielplan
    withTrainingszeiten={false}
    withFoerderverein
    active="mannschaften"
  />

  <main id="inhalt">
    <section class="container section">
      <h2 class="section-title">Herren & Senioren</h2>

      {ersteMannschaft && (
        <article class="team-star">
          {ersteMannschaft.foto && (
            <Image
              class="team-star__foto"
              src={ersteMannschaft.foto.src}
              alt={ersteMannschaft.foto.alt}
              width={1600}
              style={ersteMannschaft.foto.fokus ? `object-position: ${ersteMannschaft.foto.fokus}` : undefined}
              loading="lazy"
            />
          )}
          <div class="team-star__body">
            <div class="team__head">
              <h3 class="team__name">{ersteMannschaft.name}</h3>
              {ersteMannschaft.liga && <span class="tag tag--strong">{ersteMannschaft.liga}</span>}
            </div>
            {ersteMannschaft.text && <p class="team__text">{ersteMannschaft.text}</p>}
            {(trainerListe(ersteMannschaft).length > 0 || trainingZeilen(ersteMannschaft).length > 0) && (
              <dl class="team__meta">
                {trainerListe(ersteMannschaft).length > 0 && (
                  <div class="team__meta-row">
                    <dt>Trainer</dt>
                    <dd><TrainerListe trainer={trainerListe(ersteMannschaft)} /></dd>
                  </div>
                )}
                {trainingZeilen(ersteMannschaft).length > 0 && (
                  <div class="team__meta-row">
                    <dt>Training</dt>
                    <dd>
                      {trainingZeilen(ersteMannschaft).map((z) => (
                        <span class="training-zeile">{z}</span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
            )}
            {ersteMannschaft.platzhalter && <p class="platzhalter">Daten folgen – Kader & Trainer werden ergänzt.</p>}
          </div>
        </article>
      )}

      {weitereHerren.length > 0 && (
        <div class="teams-mini">
          {weitereHerren.map((t, i) => {
            const hatFoto = !!t.foto;
            const alt = t.foto?.alt ?? "";
            const fotoGross = fotosGross[i];
            const dialogId = `foto-dialog-${i}`;
            return (
            <article class:list={["mcard", { "mcard--foto": hatFoto }]}>
              {hatFoto && (
                <Image
                  class="mcard__bg"
                  src={t.foto!.src}
                  alt={alt}
                  width={800}
                  style={t.foto!.fokus ? `object-position: ${t.foto!.fokus}` : undefined}
                  loading="lazy"
                />
              )}
              <div class="mcard__schleier" aria-hidden="true"></div>
              <div class="mcard__body">
              <div class="team__head">
                <h3 class="mcard__name">{t.name}</h3>
                {t.liga && <span class="tag">{t.liga}</span>}
              </div>
              <dl class="mcard__meta">
                {trainerListe(t).length > 0 && (
                  <div class="team__meta-row">
                    <dt>Trainer</dt>
                    <dd><TrainerListe trainer={trainerListe(t)} /></dd>
                  </div>
                )}
                {trainingZeilen(t).length > 0 && (
                  <div class="team__meta-row">
                    <dt>Training</dt>
                    <dd>
                      {trainingZeilen(t).map((z) => (
                        <span class="training-zeile">{z}</span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
              {t.platzhalter && <p class="platzhalter">Daten folgen</p>}
              </div>
              {hatFoto && (
                <>
                  {/* Ohne JS: Link auf die Bilddatei. Mit JS: öffnet den Dialog unten. */}
                  <a
                    class="mcard__foto-btn"
                    href={fotoGross}
                    target="_blank"
                    rel="noopener"
                    data-foto-dialog={dialogId}
                    aria-label={`Mannschaftsfoto ${t.name} groß ansehen`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                  </a>
                  <dialog class="foto-dialog" id={dialogId} aria-label={`Mannschaftsfoto ${t.name}`}>
                    <img class="foto-dialog__img" src={fotoGross} alt={alt} loading="lazy" />
                    <button class="foto-dialog__close" type="button" aria-label="Schließen">×</button>
                  </dialog>
                </>
              )}
            </article>
            );
          })}
        </div>
      )}

      <h2 class="section-title jugend-title">Jugend / Nachwuchs</h2>
      <p class="prose">
        Von den Bambinis bis zur A-Jugend: Bei uns lernen Kinder und Jugendliche
        aller Altersklassen das Fußballspielen – mit Freude und fairem Miteinander.
        Schnuppern ist jederzeit möglich.
      </p>
      <div class="jugend">
        {jugend.map((j) => (
          <article class="jcard">
            <h3 class="jcard__name">{j.name}</h3>
            <p class="jcard__jahrgang">{j.jahrgang}</p>
            {trainerListe(j).length > 0 && (
              <div class="jcard__trainer">
                <span class="jcard__label">Trainer:</span>
                <TrainerListe trainer={trainerListe(j)} />
              </div>
            )}
            {trainingZeilen(j).map((z) => (
              <p class="jcard__training"><span class="jcard__label">Training:</span> {z}</p>
            ))}
            {j.platzhalter && <p class="platzhalter">Daten folgen</p>}
          </article>
        ))}
      </div>

      <p class="hinweis prose">
        Fragen zur Jugend? Schreib uns an
        <a href="mailto:kontakt@fcluebbecke.de">kontakt@fcluebbecke.de</a>.
      </p>
    </section>
    <SparteAktuelles sparte="fussball" />
  </main>

  <Footer />
</Layout>

<script>
  // Mannschaftsfoto im Overlay öffnen (progressive enhancement: ohne JS ist der
  // Kamera-Knopf ein Link auf die Bilddatei).
  document.querySelectorAll<HTMLAnchorElement>("[data-foto-dialog]").forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.fotoDialog ?? "") as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== "function") return;
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      dialog.showModal();
    });
    // Klick auf den abgedunkelten Hintergrund (= das Dialog-Element selbst) schließt
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelector(".foto-dialog__close")?.addEventListener("click", () => dialog.close());
  });
</script>

<style>
  .section { padding-block: var(--space-6); }

  /* ---- 1. Mannschaft: breite, hervorgehobene Karte ---- */
  .team-star {
    position: relative;
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .team-star::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--color-green-500);
    z-index: 1;
  }
  .team-star__foto {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .team-star__body {
    padding: var(--space-4);
  }

  /* ---- Weitere Herren-Teams: grüne Kacheln, Foto ggf. im Hintergrund ---- */
  .teams-mini {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .mcard {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 11rem;
    color: #fff;
    background: linear-gradient(160deg, var(--color-green-900) 0%, #0c5c15 100%);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    /* Trainer-Kontaktlinks (TrainerListe) auf dunklem Grund weiß */
    --trainer-link-color: #fff;
    --trainer-muted-color: rgba(255, 255, 255, 0.75);
  }
  .mcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  /* grüner Akzent oben wie bei der Ersten */
  .mcard::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--color-green-500);
    z-index: 3;
  }
  /* Foto als Hintergrund (echtes <img> für Alt-Text & Lazy-Loading) */
  .mcard__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Grün-Schleier: unten dicht (Text), oben etwas offener */
  .mcard__schleier {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 80, 18, 0.94) 0%,
      rgba(10, 80, 18, 0.80) 55%,
      rgba(10, 80, 18, 0.62) 100%
    );
    transition: background 0.25s ease;
  }
  /* Hover / Fokus: Foto tritt hervor, Textbereich unten bleibt dunkel */
  .mcard--foto:hover .mcard__schleier,
  .mcard--foto:focus-within .mcard__schleier {
    background: linear-gradient(
      to top,
      rgba(10, 80, 18, 0.90) 0%,
      rgba(10, 80, 18, 0.70) 40%,
      rgba(10, 80, 18, 0.12) 100%
    );
  }
  .mcard__body {
    position: relative;
    z-index: 1;
    padding: var(--space-3);
    /* Text am unteren Rand sammeln, damit oben Platz fürs Foto bleibt */
    margin-top: auto;
  }
  .mcard__name { color: #fff; }
  .mcard .tag {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: #fff;
  }
  .mcard .team__meta-row dt { color: rgba(255, 255, 255, 0.75); }
  .mcard .team__meta-row dd { color: #fff; }
  .mcard .platzhalter { color: rgba(255, 255, 255, 0.7); }

  /* Kamera-Knopf: Tippfläche 44 px, nur bei Karten mit Foto */
  .mcard__foto-btn {
    position: absolute;
    right: 0.6rem;
    top: 0.9rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.5);
    transition: background 0.18s ease;
  }
  .mcard__foto-btn:hover,
  .mcard__foto-btn:focus-visible {
    background: rgba(255, 255, 255, 0.32);
    outline-offset: 2px;
  }
  .mcard__foto-btn svg { width: 1.35rem; height: 1.35rem; }

  /* Overlay: natives <dialog>, Bild bleibt im Seitenverhältnis */
  .foto-dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 95vw;
    max-height: 95vh;
  }
  .foto-dialog::backdrop { background: rgba(0, 0, 0, 0.82); }
  .foto-dialog__img {
    display: block;
    max-width: 95vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
  }
  .foto-dialog__close {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 0;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .foto-dialog__close:hover,
  .foto-dialog__close:focus-visible { background: rgba(0, 0, 0, 0.8); }

  @media (prefers-reduced-motion: reduce) {
    .mcard, .mcard__schleier, .mcard__foto-btn { transition: none; }
  }

  .mcard__meta {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.35rem;
  }
  .team__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .team__name { color: var(--color-green-900); }
  .team__text {
    margin-top: 0.6rem;
    color: var(--color-ink);
  }
  .team__meta {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.35rem;
  }
  .team__meta-row {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-small);
  }
  .team__meta-row dt {
    flex: none;
    min-width: 4.5rem;
    color: var(--color-muted);
    font-family: var(--font-head);
  }
  .team__meta-row dd {
    margin: 0;
    color: var(--color-ink);
  }
  /* mehrere Trainingseinheiten: eine pro Zeile */
  .training-zeile { display: block; }
  .platzhalter {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    font-style: italic;
  }
  .hinweis { margin-top: var(--space-4); }

  /* ---- Jugend ---- */
  .jugend-title { margin-top: var(--space-6); }
  .jugend {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .jcard {
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .jcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .jcard__name { color: var(--color-green-900); }
  .jcard__jahrgang {
    color: var(--color-green-700);
    font-family: var(--font-head);
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .jcard__trainer {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
  }
  .jcard__training { margin-top: 0.3rem; }
  .jcard__label { color: var(--color-muted); }

  @media (min-width: 760px) {
    .teams-mini { grid-template-columns: repeat(3, 1fr); }
    .mcard { min-height: 15rem; }
    .jugend { grid-template-columns: repeat(3, 1fr); }
  }
</style>
