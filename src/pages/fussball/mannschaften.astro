---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import Footer from "../../components/Footer.astro";
import { getMannschaften, urlFor } from "../../lib/sanity";

// Gepflegte Fallback-Daten: greifen, solange in Sanity noch keine Mannschaften
// angelegt sind (oder der Build offline läuft).
// 1. Mannschaft (Landesliga) + D-Jugend (Trainer Peter Dahm) belegt; übrige = Platzhalter.
const herrenFallback = [
  {
    name: "1. Mannschaft",
    liga: "Landesliga",
    text: "Unser Aushängeschild: Die Erste spielt in der Landesliga und kämpft Woche für Woche um Punkte.",
    platzhalter: false,
  },
  {
    name: "2. Mannschaft",
    liga: "Kreisliga",
    text: "Die Reserve – Sprungbrett für Talente und Heimat für erfahrene Spieler.",
    platzhalter: true,
  },
  {
    name: "Alte Herren",
    liga: "Freizeit",
    text: "Fußball mit Tradition und Geselligkeit – einmal Kicker, immer Kicker.",
    platzhalter: true,
  },
];

const jugendFallback = [
  { name: "A-Jugend", jahrgang: "17–18 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "B-Jugend", jahrgang: "15–16 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "C-Jugend", jahrgang: "13–14 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "D-Jugend (D1)", jahrgang: "11–12 Jahre", trainer: "Peter Dahm (Cheftrainer)", trainingszeiten: "Montag, 17:00–18:30 Uhr", platzhalter: false },
  { name: "E-Jugend", jahrgang: "9–10 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "F-Jugend", jahrgang: "7–8 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "Bambini / G-Jugend", jahrgang: "bis 6 Jahre", trainer: "N. N.", platzhalter: true },
];

// Aus Sanity laden und nach Kategorie aufteilen. Fehlt eine Kategorie komplett,
// greift der jeweilige Fallback – so bleibt die Seite immer gefüllt.
const docs = await getMannschaften();
const herrenCms = docs.filter((d) => d.kategorie === "herren");
const jugendCms = docs.filter((d) => d.kategorie === "jugend");

const herren = herrenCms.length > 0 ? herrenCms : herrenFallback;
const jugend = jugendCms.length > 0 ? jugendCms : jugendFallback;

// Die erste Mannschaft (per Reihenfolge sortiert) wird als breite Karte mit
// Foto hervorgehoben; alle weiteren Herren-Teams kompakt nur mit Daten.
const [ersteMannschaft, ...weitereHerren] = herren;
---

<Layout title="Mannschaften – Fußball – FC Lübbecke" description="Die Fußball-Mannschaften des FC Lübbecke: Herren (1. Mannschaft Landesliga, 2. Mannschaft, Alte Herren) und Jugend von den Bambinis bis zur A-Jugend.">
  <Header active="fussball" />
  <SparteHeader
    name="Fußball"
    claim="Die größte Sparte des FC Lübbecke – von der 1. Mannschaft bis zur Jugend."
    basePath="/fussball"
    tag="Größte Sparte"
    withSpielplan
    withTrainingszeiten={false}
    withFoerderverein
    active="mannschaften"
  />

  <main id="inhalt">
    <section class="container section">
      <h2 class="section-title">Herren & Senioren</h2>

      {ersteMannschaft && (
        <article class="team-star">
          {ersteMannschaft.foto?.asset && (
            <img
              class="team-star__foto"
              src={urlFor(ersteMannschaft.foto).width(1600).height(900).fit("crop").auto("format").url()}
              alt={ersteMannschaft.foto.alt || `Mannschaftsfoto ${ersteMannschaft.name}`}
              loading="lazy"
            />
          )}
          <div class="team-star__body">
            <div class="team__head">
              <h3 class="team__name">{ersteMannschaft.name}</h3>
              {ersteMannschaft.liga && <span class="tag tag--strong">{ersteMannschaft.liga}</span>}
            </div>
            {ersteMannschaft.text && <p class="team__text">{ersteMannschaft.text}</p>}
            {(ersteMannschaft.trainer || ersteMannschaft.trainingszeiten) && (
              <dl class="team__meta">
                {ersteMannschaft.trainer && (
                  <div class="team__meta-row">
                    <dt>Trainer</dt>
                    <dd>{ersteMannschaft.trainer}</dd>
                  </div>
                )}
                {ersteMannschaft.trainingszeiten && (
                  <div class="team__meta-row">
                    <dt>Training</dt>
                    <dd>{ersteMannschaft.trainingszeiten}</dd>
                  </div>
                )}
              </dl>
            )}
            {ersteMannschaft.platzhalter && <p class="platzhalter">Daten folgen – Kader & Trainer werden ergänzt.</p>}
          </div>
        </article>
      )}

      {weitereHerren.length > 0 && (
        <div class="teams-mini">
          {weitereHerren.map((t) => (
            <article class="mcard">
              <div class="team__head">
                <h3 class="mcard__name">{t.name}</h3>
                {t.liga && <span class="tag">{t.liga}</span>}
              </div>
              <dl class="mcard__meta">
                {t.trainer && (
                  <div class="team__meta-row">
                    <dt>Trainer</dt>
                    <dd>{t.trainer}</dd>
                  </div>
                )}
                {t.trainingszeiten && (
                  <div class="team__meta-row">
                    <dt>Training</dt>
                    <dd>{t.trainingszeiten}</dd>
                  </div>
                )}
              </dl>
              {t.platzhalter && <p class="platzhalter">Daten folgen</p>}
            </article>
          ))}
        </div>
      )}

      <h2 class="section-title jugend-title">Jugend / Nachwuchs</h2>
      <p class="prose">
        Von den Bambinis bis zur A-Jugend: Bei uns lernen Kinder und Jugendliche
        aller Altersklassen das Fußballspielen – mit Freude und fairem Miteinander.
        Schnuppern ist jederzeit möglich.
      </p>
      <div class="jugend">
        {jugend.map((j) => (
          <article class="jcard">
            <h3 class="jcard__name">{j.name}</h3>
            <p class="jcard__jahrgang">{j.jahrgang}</p>
            <p class="jcard__trainer"><span class="jcard__label">Trainer:</span> {j.trainer}</p>
            {j.trainingszeiten && (
              <p class="jcard__training"><span class="jcard__label">Training:</span> {j.trainingszeiten}</p>
            )}
            {j.platzhalter && <p class="platzhalter">Daten folgen</p>}
          </article>
        ))}
      </div>

      <p class="hinweis prose">
        Fragen zur Jugend? Schreib der Jugendabteilung an
        <a href="mailto:jugend@fc-luebbecke.de">jugend@fc-luebbecke.de</a>.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section { padding-block: var(--space-6); }

  /* ---- 1. Mannschaft: breite, hervorgehobene Karte ---- */
  .team-star {
    position: relative;
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .team-star::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--color-green-500);
    z-index: 1;
  }
  .team-star__foto {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .team-star__body {
    padding: var(--space-4);
  }

  /* ---- Weitere Herren-Teams: kompakte Daten-Karten ---- */
  .teams-mini {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .mcard {
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .mcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .mcard__name { color: var(--color-green-900); }
  .mcard__meta {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.35rem;
  }
  .team__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .team__name { color: var(--color-green-900); }
  .team__text {
    margin-top: 0.6rem;
    color: var(--color-ink);
  }
  .team__meta {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.35rem;
  }
  .team__meta-row {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-small);
  }
  .team__meta-row dt {
    flex: none;
    min-width: 4.5rem;
    color: var(--color-muted);
    font-family: var(--font-head);
  }
  .team__meta-row dd {
    margin: 0;
    color: var(--color-ink);
  }
  .platzhalter {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    font-style: italic;
  }
  .hinweis { margin-top: var(--space-4); }

  /* ---- Jugend ---- */
  .jugend-title { margin-top: var(--space-6); }
  .jugend {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .jcard {
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .jcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .jcard__name { color: var(--color-green-900); }
  .jcard__jahrgang {
    color: var(--color-green-700);
    font-family: var(--font-head);
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .jcard__trainer { margin-top: 0.6rem; }
  .jcard__training { margin-top: 0.3rem; }
  .jcard__label { color: var(--color-muted); }

  @media (min-width: 760px) {
    .teams-mini { grid-template-columns: repeat(3, 1fr); }
    .jugend { grid-template-columns: repeat(3, 1fr); }
  }
</style>
