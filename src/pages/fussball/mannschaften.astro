---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import Footer from "../../components/Footer.astro";
// 1. Mannschaft (Landesliga) + D-Jugend (Trainer Peter Dahm) belegt; übrige = Platzhalter.

const herren = [
  {
    name: "1. Mannschaft",
    liga: "Landesliga",
    text: "Unser Aushängeschild: Die Erste spielt in der Landesliga und kämpft Woche für Woche um Punkte.",
    platzhalter: false,
  },
  {
    name: "2. Mannschaft",
    liga: "Kreisliga",
    text: "Die Reserve – Sprungbrett für Talente und Heimat für erfahrene Spieler.",
    platzhalter: true,
  },
  {
    name: "Alte Herren",
    liga: "Freizeit",
    text: "Fußball mit Tradition und Geselligkeit – einmal Kicker, immer Kicker.",
    platzhalter: true,
  },
];

const jugend = [
  { name: "A-Jugend", jahrgang: "17–18 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "B-Jugend", jahrgang: "15–16 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "C-Jugend", jahrgang: "13–14 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "D-Jugend (D1)", jahrgang: "11–12 Jahre", trainer: "Peter Dahm (Cheftrainer)", platzhalter: false },
  { name: "E-Jugend", jahrgang: "9–10 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "F-Jugend", jahrgang: "7–8 Jahre", trainer: "N. N.", platzhalter: true },
  { name: "Bambini / G-Jugend", jahrgang: "bis 6 Jahre", trainer: "N. N.", platzhalter: true },
];
---

<Layout title="Mannschaften – Fußball – FC Lübbecke" description="Die Fußball-Mannschaften des FC Lübbecke: Herren (1. Mannschaft Landesliga, 2. Mannschaft, Alte Herren) und Jugend von den Bambinis bis zur A-Jugend.">
  <Header active="fussball" />
  <SparteHeader
    name="Fußball"
    claim="Die größte Sparte des FC Lübbecke – von der 1. Mannschaft bis zur Jugend."
    basePath="/fussball"
    tag="Größte Sparte"
    withSpielplan
    withTrainingszeiten={false}
    active="mannschaften"
  />

  <main id="inhalt">
    <section class="container section">
      <h2 class="section-title">Herren & Senioren</h2>
      <div class="teams">
        {herren.map((t) => (
          <article class="team">
            <div class="team__head">
              <h3 class="team__name">{t.name}</h3>
              <span class="tag">{t.liga}</span>
            </div>
            <p class="team__text">{t.text}</p>
            {t.platzhalter && <p class="platzhalter">Daten folgen – Kader & Trainer werden ergänzt.</p>}
          </article>
        ))}
      </div>

      <h2 class="section-title jugend-title">Jugend / Nachwuchs</h2>
      <p class="prose">
        Von den Bambinis bis zur A-Jugend: Bei uns lernen Kinder und Jugendliche
        aller Altersklassen das Fußballspielen – mit Freude und fairem Miteinander.
        Schnuppern ist jederzeit möglich.
      </p>
      <div class="jugend">
        {jugend.map((j) => (
          <article class="jcard">
            <h3 class="jcard__name">{j.name}</h3>
            <p class="jcard__jahrgang">{j.jahrgang}</p>
            <p class="jcard__trainer"><span class="jcard__label">Trainer:</span> {j.trainer}</p>
            {j.platzhalter && <p class="platzhalter">Daten folgen</p>}
          </article>
        ))}
      </div>

      <p class="hinweis prose">
        Fragen zur Jugend? Schreib der Jugendabteilung an
        <a href="mailto:jugend@fc-luebbecke.de">jugend@fc-luebbecke.de</a>.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section { padding-block: var(--space-6); }

  .teams {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .team {
    position: relative;
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
    padding-top: calc(var(--space-4) + 4px);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .team::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--color-green-500);
  }
  .team:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: rgba(10, 80, 18, 0.18);
  }
  .team__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .team__name { color: var(--color-green-900); }
  .team__text {
    margin-top: 0.6rem;
    color: var(--color-ink);
  }
  .platzhalter {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
    font-style: italic;
  }
  .hinweis { margin-top: var(--space-4); }

  /* ---- Jugend ---- */
  .jugend-title { margin-top: var(--space-6); }
  .jugend {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .jcard {
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-left: 4px solid var(--color-green-500);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .jcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .jcard__name { color: var(--color-green-900); }
  .jcard__jahrgang {
    color: var(--color-green-700);
    font-family: var(--font-head);
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .jcard__trainer { margin-top: 0.6rem; }
  .jcard__label { color: var(--color-muted); }

  @media (min-width: 760px) {
    .teams { grid-template-columns: repeat(3, 1fr); }
    .jugend { grid-template-columns: repeat(3, 1fr); }
  }
</style>
