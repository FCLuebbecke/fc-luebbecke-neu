---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import Footer from "../../components/Footer.astro";
import { spielplan as fallback } from "../../data/spielplan";
import { getNextMatches } from "../../lib/fussball";
import { teamGruppen, VEREIN_URL } from "../../data/fussball-teams";

// Live von FUSSBALL.DE (zur Build-Zeit). Nächste Spiele fallen auf die gepflegte
// Liste zurück, falls fußball.de beim Build nicht erreichbar ist.
let matches = await getNextMatches();
const liveDaten = matches.length > 0;
if (!liveDaten) {
  matches = fallback.map((s) => ({
    ...s,
    istHeimspiel: s.heim.toLowerCase().includes("lübbecke"),
  }));
}

const istFCL = (name: string) => name.toLowerCase().includes("lübbecke");
---

<Layout title="Spielplan – Fußball – FC Lübbecke" description="Spielplan der 1. Mannschaft des FC Lübbecke – live von FUSSBALL.DE – sowie alle Mannschaften mit Link zu Spielplan, Ergebnissen und Tabelle auf fußball.de.">
  <Header active="fussball" />
  <SparteHeader
    name="Fußball"
    claim="Die größte Sparte des FC Lübbecke – von der 1. Mannschaft bis zur Jugend."
    basePath="/fussball"
    tag="Größte Sparte"
    withSpielplan
    withTrainingszeiten={false}
    withFoerderverein
    active="spielplan"
  />

  <main id="inhalt">
    <!-- ── Nächste Spiele (1. Mannschaft) ── -->
    <section class="container section">
      <h2 class="section-title">Nächste Spiele</h2>
      <p class="quelle">1. Mannschaft · {liveDaten ? "live von FUSSBALL.DE" : "Stand: gepflegte Liste"}</p>

      <div class="tabelle-wrap">
        <table class="tabelle">
          <thead>
            <tr>
              <th scope="col">Datum</th>
              <th scope="col">Anstoß</th>
              <th scope="col">Begegnung</th>
              <th scope="col">Wettbewerb</th>
            </tr>
          </thead>
          <tbody>
            {matches.map((s) => (
              <tr>
                <th scope="row">{s.datum}</th>
                <td>{s.zeit} Uhr</td>
                <td class:list={["begegnung", { "begegnung--heim": istFCL(s.heim) }]}>
                  <span class={istFCL(s.heim) ? "ist-fcl" : ""}>{s.heim}</span>
                  <span class="vs"> – </span>
                  <span class={istFCL(s.gast) ? "ist-fcl" : ""}>{s.gast}</span>
                </td>
                <td><span class="tag">{s.wettbewerb}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Alle Mannschaften bei FUSSBALL.DE ── -->
    <section class="container section section--teams">
      <h2 class="section-title">Alle Mannschaften</h2>
      <p class="prose">
        Spielplan, Ergebnisse und Tabelle jeder Mannschaft gibt es immer
        topaktuell auf FUSSBALL.DE. Wähle dein Team:
      </p>

      {teamGruppen.map((gruppe) => (
        <div class="gruppe">
          <h3 class="gruppe__title">{gruppe.title}</h3>
          <ul class="teamliste">
            {gruppe.teams.map((t) => (
              <li>
                <a class="teamlink" href={t.url} target="_blank" rel="noopener noreferrer">
                  <span class="teamlink__info">
                    <span class="teamlink__name">{t.name}</span>
                  </span>
                  <span class="teamlink__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7" />
                      <path d="M8 7h9v9" />
                    </svg>
                  </span>
                  <span class="sr-only"> – auf FUSSBALL.DE öffnen (neues Fenster)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="ext">
        <a class="btn btn--primary" href={VEREIN_URL} target="_blank" rel="noopener noreferrer">
          Zum Vereinsprofil auf FUSSBALL.DE
          <span aria-hidden="true"> ↗</span>
          <span class="sr-only"> (öffnet in neuem Fenster)</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section { padding-block: var(--space-6); }
  .section--teams { padding-top: 0; }

  .quelle {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  /* ---- Tabelle Nächste Spiele ---- */
  .tabelle-wrap {
    margin-top: var(--space-3);
    overflow-x: auto;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
  }
  .tabelle {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .tabelle th,
  .tabelle td {
    text-align: left;
    padding: 0.8rem var(--space-3);
    border-bottom: 1px solid rgba(10, 80, 18, 0.08);
    vertical-align: middle;
  }
  .tabelle thead th {
    background: var(--color-green-700);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 500;
  }
  .tabelle tbody th {
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--color-green-900);
    white-space: nowrap;
  }
  .tabelle tbody tr:nth-child(even) { background: var(--color-green-050); }
  .tabelle tbody tr:last-child th,
  .tabelle tbody tr:last-child td { border-bottom: 0; }

  .ist-fcl { font-weight: 600; color: var(--color-green-900); }
  .vs { color: var(--color-muted); }

  /* ---- Mannschafts-Links (Karten) ---- */
  .gruppe { margin-top: var(--space-5); }
  .gruppe__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-green-900);
    margin-bottom: var(--space-3);
  }
  .gruppe__title::before {
    content: "";
    width: 5px;
    height: 1.1em;
    background: var(--color-green-500);
    border-radius: 3px;
    flex: none;
  }

  .teamliste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .teamlink {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-3);
    background: #fff;
    border: 1px solid rgba(10, 80, 18, 0.10);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .teamlink:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: rgba(10, 80, 18, 0.22);
  }
  .teamlink__info {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    align-items: flex-start;
    min-width: 0;
  }
  .teamlink__name {
    font-family: var(--font-head);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-green-900);
  }
  .teamlink__icon {
    flex: none;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--color-green-700);
    background: var(--color-green-050);
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }
  .teamlink:hover .teamlink__icon {
    background: var(--color-green-700);
    color: #fff;
    transform: translate(2px, -2px);
  }

  .ext { margin-top: var(--space-6); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  @media (min-width: 640px) {
    .teamliste { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .teamliste { grid-template-columns: repeat(3, 1fr); }
  }
</style>
