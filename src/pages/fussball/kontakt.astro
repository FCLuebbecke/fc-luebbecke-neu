---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SparteHeader from "../../components/SparteHeader.astro";
import Footer from "../../components/Footer.astro";
import { KONTAKT_MAIL, KONTAKT_MAILTO } from "../../data/kontakt";
// Belegt: Vereins-Mail kontakt@fcluebbecke.de, Anschrift Obernfelder Allee 42.

const kontakte = [
  {
    titel: "Fußballabteilung",
    text: "Für alle Fragen rund um die Herren- und Senioren-Teams.",
    mail: KONTAKT_MAIL,
  },
  {
    titel: "Jugendabteilung",
    text: "Für den Nachwuchs von den Bambinis bis zur A-Jugend.",
    mail: KONTAKT_MAIL,
  },
];
---

<Layout title="Kontakt – Fußball – FC Lübbecke" description="Kontakt zur Fußball- und Jugendabteilung des FC Lübbecke. Anschrift, E-Mail und Probetraining.">
  <Header active="fussball" />
  <SparteHeader
    name="Fußball"
    claim="Die größte Sparte des FC Lübbecke – von der 1. Mannschaft bis zur Jugend."
    basePath="/fussball"
    tag="Größte Sparte"
    withSpielplan
    withTrainingszeiten={false}
    withFoerderverein
    active="kontakt"
  />

  <main id="inhalt">
    <section class="sparte__cta">
      <div class="container sparte__cta-grid">
        <div>
          <h2 class="sparte__cta-title">Lust mitzukicken?</h2>
          <p class="sparte__cta-text">
            Egal ob Profi oder Wiedereinsteiger, jung oder Alt – komm zu einem
            Probetraining auf unsere Anlage an der Obernfelder Allee. Schreib uns
            kurz, dann sagen wir dir, wann das passende Team trainiert.
          </p>
          <a class="btn btn--primary" href={`${KONTAKT_MAILTO}?subject=Probetraining%20Fu%C3%9Fball`}>
            Probetraining anfragen
          </a>
        </div>

        <aside class="kontakte">
          {kontakte.map((k) => (
            <div class="kontakt">
              <h3 class="kontakt__titel">{k.titel}</h3>
              <p class="kontakt__text">{k.text}</p>
              <p class="kontakt__mail">
                <a href={KONTAKT_MAILTO}>
                  <svg class="kontakt__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                  {k.mail}
                </a>
              </p>
            </div>
          ))}

          <div class="kontakt kontakt--adresse">
            <h3 class="kontakt__titel">Sportanlage</h3>
            <address class="kontakt__adresse">
              FC Lübbecke e.V.<br />
              Obernfelder Allee 42<br />
              32312 Lübbecke
            </address>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .sparte__cta {
    background: var(--color-white);
    color: var(--color-ink);
    padding-block: var(--space-6);
  }
  .sparte__cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .sparte__cta-title { color: var(--color-green-700); }
  .sparte__cta-text {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--color-ink);
    max-width: 52ch;
  }

  .kontakte {
    display: grid;
    gap: var(--space-3);
  }
  .kontakt {
    background: var(--color-green-050);
    border: 1px solid rgba(10, 80, 18, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .kontakt:hover {
    transform: translateY(-2px);
    background: #dcecdd;
  }
  .kontakt__titel { color: var(--color-ink); }
  .kontakt__ico { width: 1.05em; height: 1.05em; flex: none; vertical-align: -0.18em; margin-right: 0.4rem; opacity: 0.85; }
  .kontakt__text {
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-size: var(--fs-small);
  }
  .kontakt__mail { margin-top: 0.5rem; }
  .kontakt a {
    color: var(--color-green-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .kontakt a:hover { color: var(--color-green-900); }
  .kontakt__adresse {
    font-style: normal;
    margin-top: 0.3rem;
    line-height: 1.6;
  }

  @media (min-width: 860px) {
    .sparte__cta-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-6);
    }
  }
</style>
